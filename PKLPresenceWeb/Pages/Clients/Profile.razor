@attribute [Authorize]
@page "/home/profile"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AlertService AlertService

@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model

<div class="profile-page">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">Profile</h5>
    </div>

    <div class="content-section">
        <div class="card mb-4 d-flex flex-row align-items-center justify-content-center">
            <img src="@photoUrl" class="profile-photo me-3" />
            <div class="d-flex flex-column text-start">
                <div class="fw-bold">@fullName</div>
                <div class="text-muted" style="font-size: 0.75em;">@email</div>
            </div>
        </div>

        <div class="card p-2 mb-4">
            <MenuItem icon="bi-person" text="My Profile" link="/home/profile/me" />
            <MenuItem icon="bi-calendar-check" text="Presence" link="/presence" />
            <MenuItem icon="bi-file-earmark-text" text="Intern Report" link="/report" />
            <MenuItem icon="bi-info-circle" text="Change Password" link="/home/profile/change-password" />
            @if (userRole == "Admin" || userRole == "Kepala Jurusan")
            {
                <MenuItem icon="bi-chat-dots" text="Activate Message"
                          ShowSwitch="true"
                          SwitchValue="@isMessageActive"
                          SwitchValueChanged="OnActivateMessageChanged"
                          Disabled="@isLoadingSwitch" />
            }
            else if (userRole == "Student")
            {
                <MenuItem icon="bi-journal-text"
                          text="Recap"
                          link="/home/profile/recap"
                          Disabled="@isRekapDisabled" />
            }
            <MenuItem icon="@(isDark ? "bi-moon" : "bi-sun")"
                      RightIcon="@(isDark ? "bi-sun" : "bi-moon")"
                      text="Theme"
                      ShowSwitch="false"
                      OnClickAction="ToggleThemeFromProfile" />
        </div>

        <div class="d-flex justify-content-center">
            <button class="btn btn-danger" style="width: 400px;" @onclick="Logout">
                Log Out
            </button>
        </div>
    </div>
</div>