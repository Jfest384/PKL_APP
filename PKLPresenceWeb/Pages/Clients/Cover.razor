@page "/"
@using PKLPresenceWeb.Model

@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Cover</PageTitle>

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100">
    <h1 class="mb-3 text-center fw-bold">Welcome!</h1>
    <p class="text-center mb-5" style="width: 90%">
        This app is designed to help you record Presence and submit Intern Report.
    </p>
    <img src="images/logo.png" alt="Logo" class="mb-5 mt-5" style="max-width: 200px; width: 100%;" />
    <button class="btn btn-primary btn-lg mt-5" style="width: 250px" @onclick="OnLetsGoClicked">Let's Go</button>
</div>

@code {
    private async Task OnLetsGoClicked()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Validasi token ke backend
        try
        {
            var http = new HttpClient();
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await http.GetAsync(APIUrl.Endpoint("me"));

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/home");
            }
            else
            {
                // Token tidak valid/expired
                await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
                Navigation.NavigateTo("/login");
            }
        }
        catch
        {
            // Jika error (misal network), anggap token tidak valid
            await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
            Navigation.NavigateTo("/login");
        }
    }
}