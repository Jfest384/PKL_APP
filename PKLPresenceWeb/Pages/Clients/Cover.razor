@page "/"
@using PKLPresenceWeb.Model

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100">
    <h1 class="mb-3 text-center fw-bold">Welcome!</h1>
    <p class="text-center mb-5" style="width: 90%">
        This app is designed to help you record Presence and submit Intern Report.
    </p>
    <img src="images/logo.png" alt="Logo" class="mb-5 mt-5" style="max-width: 200px; width: 100%;" />
    <button class="btn btn-primary btn-lg mt-5" style="width: 250px" @onclick="OnLetsGoClicked">Let's Go</button>
</div>

@code {
    private async Task OnLetsGoClicked()
    {
        try
        {
            var response = await Http.GetAsync(APIUrl.Endpoint("me"));
            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/home");
            else
            {
                await JS.InvokeVoidAsync("localStorage.clear");
                Navigation.NavigateTo("/login");
            }
        }
        catch
        {
            await JS.InvokeVoidAsync("localStorage.clear");
            Navigation.NavigateTo("/login");
        }
    }
}