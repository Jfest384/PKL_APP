@attribute [Authorize]
@page "/home/profile/change-password"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AlertService AlertService

<div class="change-pass-wrapper">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">Change Password</h5>
    </div>

    <div class="content-section d-flex flex-column align-items-center">
        <div class="card w-100 shadow-sm d-flex flex-column align-items-center p-4 justify-content-center">
            <p style="margin-bottom:1rem;text-align:justify;">
                To change your password, please fill in the fields below.
            </p>

            <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div style="margin-bottom:1rem;position:relative;">
                    <InputText @bind-Value="model.oldPassword" type="@currentPasswordInputType" placeholder="Enter current password" class="form-control" style="width:100%;padding-right:40px;" />

                    <button type="button" @onclick="ToggleCurrentPassword"
                            class="password-toggle-btn"
                            style="position:absolute;right:10px;top:5px;">
                        <span>@(currentPasswordInputType == "password" ? "👁️" : "🙈")</span>
                    </button>

                    @if (!string.IsNullOrEmpty(currentPasswordError))
                    {
                        <div class="text-danger" style="font-size:0.95em;">@currentPasswordError</div>
                    }
                </div>

                <div style="margin-bottom:1rem;position:relative;">
                    <InputText @bind-Value="model.newPassword" type="@newPasswordInputType" placeholder="Enter new password" class="form-control" style="width:100%;padding-right:40px;" />
                    
                    <button type="button" @onclick="ToggleNewPassword"
                            class="password-toggle-btn"
                            style="position:absolute;right:10px;top:5px;">
                        <span>@(newPasswordInputType == "password" ? "👁️" : "🙈")</span>
                    </button>

                    @if (!string.IsNullOrEmpty(newPasswordError))
                    {
                        <div class="text-danger" style="font-size:0.95em;">@newPasswordError</div>
                    }
                </div>

                <div style="margin-bottom:0.5rem;">
                    <div style="font-size:0.95em;margin-bottom:0.5rem;">
                        Password must contain:
                        <ul style="margin:0.5em 0 0 1em;">
                            <li>At least 8 characters</li>
                            <li>At least one number (0–9)</li>
                            <li>At least one special character</li>
                        </ul>
                    </div>
                </div>

                <div style="margin-bottom:1rem;position:relative;">
                    <InputText @bind-Value="model.confirmPassword" type="@confirmPasswordInputType" placeholder="Confirm new password" class="form-control" style="width:100%;padding-right:40px;" />
                    
                    <button type="button" @onclick="ToggleConfirmPassword"
                            class="password-toggle-btn"
                            style="position:absolute;right:10px;top:5px;">
                        <span>@(confirmPasswordInputType == "password" ? "👁️" : "🙈")</span>
                    </button>

                    @if (!string.IsNullOrEmpty(confirmPasswordError))
                    {
                        <div class="text-danger" style="font-size:0.95em;">@confirmPasswordError</div>
                    }
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%;font-weight:600;">
                    <i class="bi bi-lock-fill"></i>
                    <span class="btn-text-sm-hide ms-1">Change Password</span>
                </button>
            </EditForm>
        </div>
    </div>
</div>
