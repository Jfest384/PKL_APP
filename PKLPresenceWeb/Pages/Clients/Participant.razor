@page "/participant"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using PKLPresenceWeb.Model
@using System.Net.Http.Headers

<div class="participant-wrapper">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">Participant</h5>
    </div>

    <div class="content-section">
        <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
            @foreach (var tab in VisibleTabs)
            {
                <li class="nav-item flex-fill text-center">
                    <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "")" style="width:100%;" @onclick="() => ChangeTab(tab)">@tab</button>
                </li>
            }
        </ul>

        @if (UserRole != "Student" && CurrentTab != "Pembimbing PKL")
        {
            <div class="row g-2 mb-3">
                <div class="col">
                    <input class="form-control" placeholder="Nama Siswa..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in Classes)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="scrollable-x">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            @foreach (var header in GetHeaders())
                            {
                                <th class="text-center">@header</th>
                            }
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa TKJ")
                            {
                                <th class="text-center">Action</th>
                            }
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Pembimbing PKL")
                            {
                                <th class="text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (GetCurrentData().Count == 0)
                        {
                            <tr>
                                <td colspan="@(GetHeaders().Count + 1 + ((UserRole != "Student") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Pembimbing PKL") ? 1 : 0))" class="text-center text-muted">
                                    Tidak ada data @(CurrentTab).
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (CurrentPage - 1) * 10; // 10 = page size, sesuaikan jika page size dinamis
                            @foreach (var item in GetCurrentData())
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    @if (CurrentTab == "Siswa TKJ")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success"
                                                            @onclick="() => NavigateToClassManagement(item)">
                                                        <i class="bi bi-person-plus"></i> ke Kelas
                                                    </button>
                                                    <button class="btn btn-sm btn-warning"
                                                            @onclick="() => ConfirmAddToPkl(item)">
                                                        <i class="bi bi-person-plus"></i> ke Siswa PKL
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Pembimbing PKL")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td class="justify-content-center">
                                                <button class="btn btn-sm btn-success" @onclick="() => OnAddStudentToMentor(item)">
                                                    <i class="bi bi-plus-lg me-1"></i> Tambah Siswa
                                                </button>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Siswa PKL")
                                    {
                                        for (int i = 1; i <= 5 && i < item.Length; i++)
                                        {
                                            if (i == 5 && (UserRole == "Admin" || UserRole == "Kepala Jurusan" || UserRole == "Wali Kelas") && item[5] == "-")
                                            {
                                                <td>
                                                    <button class="btn btn-sm btn-warning" @onclick="() => OnPilihTempatPKL(item)">
                                                        Pilih Tempat PKL
                                                    </button>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>@item[i]</td>
                                            }
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa TKJ")
            {
                <div class="d-flex justify-content-center mt-3">
                    <button class="btn btn-info px-4" @onclick="@(() => Navigation.NavigateTo("/participant/class-management"))">
                        Manajemen Kelas
                    </button>
                </div>
            }

            <nav class="d-flex justify-content-center mt-2">
                <ul class="pagination">
                    @if (GetCurrentData() is null || GetCurrentData().Count == 0)
                    {
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                        </li>
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                <button class="page-link"
                                    @onclick="() => ChangePage(pageNum)"
                                    disabled="@(pageNum == CurrentPage)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        </li>
                    }
                </ul>
            </nav>
        }

        @if (ShowConfirmationModal)
        {
            <Modal IsVisible="ShowConfirmationModal">
                <div class="modal-scrollable-content">
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>@ConfirmationText</p>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            @if (ConfirmButtonText != "Done")
                            {
                                <button class="btn btn-danger px-4" @onclick="CancelModal">Cancel</button>
                            }
                            <button class="btn btn-primary px-4" @onclick="ConfirmAssignPkl">@ConfirmButtonText</button>
                        </div>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowAddStudentToMentorModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Pilih Siswa</p>
                        @if (IsLoadingStudents)
                        {
                            <div class="my-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 text-start" style="max-height:300px;overflow-y:auto;">
                                @if (AvailableStudents.Count == 0)
                                {
                                    <div class="text-center text-muted">Tidak ada siswa PKL tanpa mentor.</div>
                                }
                                else
                                {
                                    @foreach (var student in AvailableStudents)
                                    {
                                        <div class="form-check ms-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="student_@student.id"
                                                   checked="@SelectedStudentIds.Contains(student.id)"
                                                   @onchange="e => OnStudentCheckboxChanged(e, student.id)" />
                                            <label class="form-check-label" for="student_@student.id">
                                                @student.nis - @student.fullname
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CancelAddStudentToMentor">Cancel</button>
                            <button class="btn btn-primary px-4" @onclick="ConfirmAddStudentToMentor" disabled="@(SelectedStudentIds.Count == 0)">Confirm</button>
                        </div>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowPilihPTModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <h5 class="mb-3 text-center">Pilih Tempat PKL</h5>
                    @if (IsLoadingCompanies)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            @foreach (var company in Companies)
                            {
                                <div class="form-check text-start">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="companyRadio"
                                           id="company_@company.id"
                                           value="@company.id"
                                           checked="@(SelectedCompanyId == company.id)"
                                           @onchange="OnCompanyRadioChanged" />
                                    <label class="form-check-label" for="company_@company.id">
                                        @company.name
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-danger px-4" @onclick="ClosePilihPTModal">Cancel</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmPilihPT" disabled="@(SelectedCompanyId == null)">Confirm</button>
                    </div>
                </div>
            </Modal>
        }
    </div>
</div>

@code {
    private string UserRole = "";
    private string SearchText = "";
    private int? SelectedClassId;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private bool IsLoading = false;

    private List<ClassItem> Classes = new();
    private List<string> VisibleTabs = new();
    private string CurrentTab = "";

    private List<StudentItem> Students = new();
    private List<MentorItem> Mentors = new();
    private List<StudentPKLItem> StudentPKLs = new();

    private CancellationTokenSource? searchDebounceCts;

    bool ShowAddStudentToMentorModal = false;
    int? SelectedMentorId;
    string? SelectedMentorName;
    List<StudentPKLItem> AvailableStudents = new();
    HashSet<int> SelectedStudentIds = new();
    bool IsLoadingStudents = false;

    // Modal Pilih PT
    bool ShowPilihPTModal = false;
    int? SelectedStudentIdForPT = null;
    int? SelectedCompanyId = null;
    List<CompanyItem> Companies = new();
    bool IsLoadingCompanies = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        var user = await Http.GetFromJsonAsync<UserResponse>(APIUrl.Endpoint("me"));
        UserRole = user.role;

        if (UserRole != "Student")
        {
            await LoadClasses();
            VisibleTabs = new() { "Siswa TKJ", "Pembimbing PKL", "Siswa PKL" };
        }
        else VisibleTabs = new() { "Siswa PKL", "Pembimbing PKL" };

        CurrentTab = VisibleTabs.FirstOrDefault() ?? "";
        await LoadData();
    }

    private async Task LoadClasses()
    {
        var response = await Http.GetFromJsonAsync<ClassListResponse>(APIUrl.Endpoint($"classes?page={CurrentPage}"));
        if (response != null)
        {
            Classes = response.classrooms ?? new();
            TotalPages = response.totalPages;
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        string url = "";

        if (CurrentTab == "Siswa TKJ")
        {
            url = APIUrl.Endpoint($"students?page={CurrentPage}");
            if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&name={SearchText}";
            if (SelectedClassId.HasValue) url += $"&id_class={SelectedClassId}";

            var res = await Http.GetFromJsonAsync<StudentListResponse>(url);
            Students = res?.students ?? new();
            TotalPages = res?.totalPages ?? 1;
        }
        else if (CurrentTab == "Pembimbing PKL")
        {
            url = APIUrl.Endpoint($"mentors?page={CurrentPage}");
            var res = await Http.GetFromJsonAsync<MentorListResponse>(url);
            Mentors = res?.data ?? new();
            int totalItems = res?.totalItems ?? 0;
            TotalPages = (int)Math.Ceiling(totalItems / 10.0);
        }
        else if (CurrentTab == "Siswa PKL")
        {
            url = APIUrl.Endpoint($"students/pkl?page={CurrentPage}");
            if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&name={SearchText}";
            if (SelectedClassId.HasValue) url += $"&id_class={SelectedClassId}";

            var res = await Http.GetFromJsonAsync<StudentPKLListResponse>(url);
            StudentPKLs = res?.students ?? new();
            TotalPages = res?.totalPages ?? 1;
        }

        IsLoading = false;
        StateHasChanged();
    }

    private async Task ChangeTab(string tab)
    {
        CurrentTab = tab;
        CurrentPage = 1;
        SearchText = string.Empty;
        SelectedClassId = null; // reset juga class id
        ShowConfirmationModal = false;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            await LoadData();
        }
    }

    private async void OnClassChange(ChangeEventArgs e)
    {
        SelectedClassId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        CurrentPage = 1;
        await LoadData();
    }

    private async void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        searchDebounceCts?.Cancel();
        searchDebounceCts = new CancellationTokenSource();
        var token = searchDebounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                CurrentPage = 1;
                await LoadData();
            }
        }
        catch (TaskCanceledException) { }
    }

    private List<string[]> GetCurrentData()
    {
        if (CurrentTab == "Siswa TKJ")
            return Students.Select(s => new[] { s.id.ToString(), s.nis, s.fullname, s.class_name, s.classroomid.ToString(), s.isPKL.ToString() }).ToList();
        else if (CurrentTab == "Pembimbing PKL")
            return Mentors.Select(m => new[] { m.id.ToString(), m.fullname, string.Join(", ", m.classes) }).ToList();
        else if (CurrentTab == "Siswa PKL")
            return StudentPKLs.Select(p => new[] { p.id.ToString(), p.nis, p.fullname, p.class_name, p.mentor_name, p.company_name }).ToList();

        return new();
    }

    private List<string> GetHeaders()
    {
        if (CurrentTab == "Siswa TKJ") return new() { "NIS", "Nama", "Kelas" };
        if (CurrentTab == "Pembimbing PKL") return new() { "Nama", "Kelas Dibimbing" };
        if (CurrentTab == "Siswa PKL") return new() { "NIS", "Nama", "Kelas", "Pembimbing", "Tempat PKL" };
        return new();
    }

    private void GoBack() => Navigation.NavigateTo("/home");

    void NavigateToClassManagement(string[] studentRow)
    {
        var studentId = studentRow[0]; // id ada di index 0
        var isPKL = studentRow.Length > 5 ? studentRow[5] : "false"; // isPKL ada di index 5

        Navigation.NavigateTo($"/participant/class-management?studentId={studentId}&isPKL={isPKL}");
    }

    bool ShowConfirmationModal = false;
    string ConfirmationText = "Apakah Anda yakin ingin menambahkan Siswa ini ke daftar Siswa PKL?";
    string ConfirmButtonText = "Confirm";
    int SelectedStudentId;

    void ConfirmAddToPkl(string[] studentRow)
    {
        SelectedStudentId = int.Parse(studentRow[0]); // assuming id
        SelectedClassId = int.Parse(studentRow[4]); // assuming id_class
        ShowConfirmationModal = true;
        ConfirmationText = "Apakah Anda yakin ingin menambahkan Siswa ini ke daftar Siswa PKL?";
        ConfirmButtonText = "Confirm";
        StateHasChanged();
    }

    async Task ConfirmAssignPkl()
    {
        if (ConfirmButtonText == "Done")
        {
            ShowConfirmationModal = false;
            SelectedClassId = 0;
            SelectedStudentId = 0;
            return;
        }

        var payload = new { isPKL = true, idClass = SelectedClassId };
        var response = await Http.PutAsJsonAsync(APIUrl.Endpoint($"assign/{SelectedClassId}"), payload);

        if (response.IsSuccessStatusCode)
        {
            ConfirmationText = "Siswa berhasil ditambahkan ke daftar Siswa PKL!";
            ConfirmButtonText = "Done";
        }
    }

    void CancelModal()
    {
        ShowConfirmationModal = false;
        SelectedClassId = 0;
        SelectedStudentId = 0;
        StateHasChanged();
    }

    async void OnAddStudentToMentor(string[] mentorRow)
    {
        // Ambil mentorId dari mentorRow (misal index 0)
        SelectedMentorId = mentorRow.Length > 0 ? int.TryParse(mentorRow[0], out var id) ? id : (int?)null : null;
        SelectedMentorName = mentorRow.Length > 0 ? mentorRow[0] : null;

        ShowAddStudentToMentorModal = true;
        SelectedStudentIds.Clear();
        IsLoadingStudents = true;

        // Ambil semua siswa PKL tanpa mentor dari semua halaman
        var allStudents = new List<StudentPKLItem>();
        int page = 1;
        int totalPages = 1;
        do
        {
            var res = await Http.GetFromJsonAsync<StudentPKLListResponse>(APIUrl.Endpoint($"students/pkl?page={page}&noMentor=true"));
            if (res?.students != null)
                allStudents.AddRange(res.students);
            totalPages = res?.totalPages ?? 1;
            page++;
        } while (page <= totalPages);

        AvailableStudents = allStudents;
        IsLoadingStudents = false;

        StateHasChanged();
    }

    void OnStudentCheckboxChanged(ChangeEventArgs e, int studentId)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked) SelectedStudentIds.Add(studentId);
        else SelectedStudentIds.Remove(studentId);
    }

    async Task ConfirmAddStudentToMentor()
    {
        if (SelectedMentorId.HasValue && SelectedStudentIds.Count > 0)
        {
            var payload = SelectedStudentIds.ToArray();
            var response = await Http.PutAsJsonAsync(APIUrl.Endpoint($"assign/mentor/{SelectedMentorId}"), payload);
            if (response.IsSuccessStatusCode)
            {
                CancelAddStudentToMentor();
                await LoadData();
            }
        }
    }

    void CancelAddStudentToMentor()
    {
        ShowAddStudentToMentorModal = false;
        SelectedMentorId = null;
        SelectedMentorName = null;
        SelectedStudentIds.Clear();
    }

    async void OnPilihTempatPKL(string[] studentRow)
    {
        SelectedStudentIdForPT = int.Parse(studentRow[0]);
        SelectedCompanyId = null;
        ShowPilihPTModal = true;
        IsLoadingCompanies = true;
        Companies.Clear();

        try
        {
            var result = await Http.GetFromJsonAsync<List<CompanyItem>>(APIUrl.Endpoint("data/companies"));
            if (result != null)
                Companies = result;
        }
        finally
        {
            IsLoadingCompanies = false;
            StateHasChanged();
        }
    }

    void OnCompanyRadioChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            SelectedCompanyId = id;
    }

    async Task ConfirmPilihPT()
    {
        if (SelectedStudentIdForPT.HasValue && SelectedCompanyId.HasValue)
        {
            var url = APIUrl.Endpoint($"assign/company/{SelectedStudentIdForPT}?companyId={SelectedCompanyId}");
            var response = await Http.PutAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                ClosePilihPTModal();
                await LoadData();
            }
            else await JS.InvokeVoidAsync("alert", "Gagal assign tempat PKL. Coba lagi setelah beberapa saat.");
        }
    }

    void ClosePilihPTModal()
    {
        ShowPilihPTModal = false;
        SelectedStudentIdForPT = null;
        SelectedCompanyId = null;
        Companies.Clear();
    }
}