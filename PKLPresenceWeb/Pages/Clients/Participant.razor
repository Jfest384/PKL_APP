@attribute [Authorize]
@page "/participant"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HistoryState HistoryState
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Model
@using System.Net.Http.Headers

<div class="participant-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Participant</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
            @foreach (var tab in VisibleTabs)
            {
                <li class="nav-item flex-fill text-center">
                    <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "")" style="width:100%;" @onclick="() => ChangeTab(tab)">@tab</button>
                </li>
            }
        </ul>

        @if (UserRole != "Student" && CurrentTab != "Pembimbing PKL" && CurrentTab != "Manajemen Kelas")
        {
            <div class="row g-2 mb-3 align-items-center">
                <div class="col">
                    <input class="form-control" placeholder="Search..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in Classes)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
            </div>

            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa TKJ")
            {
                <div class="row mb-3 g-2">
                    <div class="col-12">
                        <div class="d-flex flex-wrap flex-md-nowrap align-items-stretch responsive-btn-group">
                            <div class="d-flex flex-grow-1 gap-2 btn-main-group">
                                <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnAssignStudentPKLClicked">
                                    <i class="bi bi-person-plus"></i> Assign PKL
                                </button>
                                <button class="btn btn-primary flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnAssignClassClicked">
                                    <i class="bi bi-people"></i> Assign Class
                                </button>
                            </div>
                            <div class="d-flex gap-2 ms-auto btn-side-group">
                                <button class="btn btn-success px-3 d-none d-sm-inline" @onclick="() => ShowAddStudentModal = true">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                                <button class="btn btn-danger px-3 d-none d-sm-inline" @onclick="OnDeleteStudentTKJClicked">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end mt-2 d-sm-none">
                            <button class="btn btn-success" style="width:48px;" @onclick="() => ShowAddStudentModal = true">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <button class="btn btn-danger" style="width:48px;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa PKL")
            {
                <div class="row mb-3 g-2">
                    <div class="col-12">
                        <div class="d-flex flex-wrap flex-md-nowrap align-items-stretch responsive-btn-group">
                            <div class="d-flex flex-grow-1 gap-2 btn-main-group">
                                <button class="btn btn-danger flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnDeleteStudentPKLClicked">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                                <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;">
                                    <i class="bi bi-upload"></i> Publish
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @if (CurrentTab == "Manajemen Kelas")
        {
            <div class="row g-2 align-items-center mb-3">
                <div class="col">
                    <input class="form-control search-class-input" placeholder="Nama Kelas..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-warning w-200" @onclick="() => ShowAddModal = true">
                        <i class="bi bi-plus-lg me-1"></i> Tambah Kelas
                    </button>
                </div>
            </div>
        }

        @if (CurrentTab == "Pembimbing PKL" && (UserRole == "Admin" || UserRole == "Kepala Jurusan"))
        {
            <div class="row g-2 mb-3 align-items-center">
                <div class="col">
                    <input class="form-control" placeholder="Search Mentor..." @bind="MentorSearchText" @oninput="OnMentorDataSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-success" @onclick="OpenAddMentorModal">
                        <i class="bi bi-person-plus"></i> Mentor
                    </button>
                </div>
            </div>
        }

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="scrollable-x">
                <table class="table table-bordered @GetTableCode()">
                    <thead>
                        <tr>
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                            {
                                <th class="text-center">
                                    <input type="checkbox" @bind="IsHeaderCheckboxChecked" />
                                </th>
                            }
                            <th class="text-center">No</th>
                            @foreach (var header in GetHeaders())
                            {
                                var sortable = false;
                                if (CurrentTab == "Siswa TKJ" && (header == "NIS" || header == "Nama" || header == "Kelas")) sortable = true;
                                else if (CurrentTab == "Pembimbing PKL" && (header == "Nama" || header == "NIP")) sortable = true;
                                else if (CurrentTab == "Siswa PKL" && (header == "NIS" || header == "Nama" || header == "Kelas" || header == "Pembimbing" || header == "Tempat PKL")) sortable = true;
                                else if (CurrentTab == "Manajemen Kelas" && (header == "Kelas" || header == "Total Siswa" || header == "Wali Kelas" || header == "Tahun")) sortable = true;

                                <th class="text-center @(sortable ? "sortable" : "")"
                                    @onclick="sortable ? (() => SortBy(header)) : null"
                                    style="cursor:@(sortable ? "pointer" : "default")">
                                    @header
                                    @if (SortColumn == header)
                                    {
                                        <span class="part-sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                            }
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") ||
                            ((CurrentTab == "Siswa PKL" || CurrentTab == "Siswa TKJ") && (UserRole == "Mentor" || UserRole == "Wali Kelas" || UserRole == "Wali Kelas & Mentor")))
                            {
                                <th class="text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (GetPagedSortedData().Count == 0)
                        {
                            int colspan = 0;
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                                colspan += 1;
                            colspan += 1;
                            colspan += GetHeaders().Count;
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") ||
                            (CurrentTab == "Siswa PKL" && (UserRole == "Mentor" || UserRole == "Wali Kelas" || UserRole == "Wali Kelas & Mentor")))
                                colspan += 1;

                            <tr>
                                <td colspan="@colspan" class="text-center text-muted">
                                    Tidak ada data @(CurrentTab).
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize; // 10 = page size, sesuaikan jika page size dinamis
                            @foreach (var item in GetPagedSortedData())
                            {
                                rowIndex++;
                                <tr>
                                    @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                                    {
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   checked="@SelectedSiswaPKLIds.Contains(int.Parse(item[0]))"
                                                   @onchange="e => OnRowCheckboxChanged(e, item)" />
                                        </td>
                                    }
                                    <td class="text-center">@rowIndex</td>
                                    @if (CurrentTab == "Siswa TKJ")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        @if (UserRole != "Teacher")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success"
                                                            @onclick="() => OnShowStudentDetail(int.Parse(item[0]))">
                                                        Detail
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Pembimbing PKL")
                                    {
                                        @if (UserRole != "Student")
                                        {
                                            <td>@item[1]</td>
                                        }
                                        <td>@item[2]</td>
                                        <td>
                                            @{
                                                var kelasDibimbing = string.IsNullOrWhiteSpace(item[3]) ? "-" : item[3];
                                            }
                                            @kelasDibimbing
                                        </td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex flex-column gap-2 align-items-center">
                                                    <button class="btn btn-sm btn-warning" style="padding-left: 0.6rem; padding-right: 0.6rem;"
                                                            @onclick="() => OnAddStudentToMentor(item)">
                                                        <i class="bi bi-plus-lg"></i> Tambah Siswa
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteMentorClicked(item)">
                                                        <i class="bi bi-trash"></i> Delete Mentor
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Siswa PKL")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>
                                            @{
                                                var tempatPKL = string.IsNullOrWhiteSpace(item[5]) ? "-" : item[5];
                                            }
                                            @tempatPKL
                                        </td>
                                        @if (UserRole != "Student" && UserRole != "Teacher")
                                        {
                                            <td>
                                                <div class="d-flex flex-column gap-2 align-items-center">
                                                    @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                                    {
                                                        @if (string.IsNullOrWhiteSpace(item[5]) || item[5] == "-")
                                                        {
                                                            <button class="btn btn-sm btn-warning" @onclick="() => OnPilihTempatPKL(item)">
                                                                <i class="bi bi-geo-alt me-1"></i> Lokasi PKL
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => OnPilihTempatPKL(item)">
                                                                <i class="bi bi-geo-alt me-1"></i> Lokasi PKL
                                                            </button>
                                                        }
                                                    }

                                                    <button class="btn btn-sm btn-primary" style="padding-left: 1.2rem; padding-right: 1.2rem;" @onclick="() => GoToHistory(item)">
                                                        <i class="bi bi-clock-history me-1"></i> History
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Manajemen Kelas")
                                    {
                                        <td>@item[1]</td>
                                        <td>
                                            @{
                                                var classId = int.Parse(item[0]);
                                                int total = StudentCountPerClass.TryGetValue(classId, out var count) ? count : 0;
                                            }
                                            @total
                                        </td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>@item[5]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success" @onclick="() => OnAssignClassToStudents(int.Parse(item[0]), item[1])">
                                                        <i class="bi bi-person-plus"></i> Siswa
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClass(int.Parse(item[0]), item[1])">
                                                        <i class="bi bi-trash"></i> Kelas
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <select class="form-select page-size-dropdown my-3" style="max-width:160px;" @bind="PageSize">
                <option value="10">Show 10 Entries</option>
                <option value="50">Show 50 Entries</option>
                <option value="100">Show 100 Entries</option>
                <option value="1000">Show All Entries</option>
            </select>

            <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                <ul class="pagination d-flex flex-wrap justify-content-center">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                        <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>

                    @* Selalu tampilkan page 1 *@
                    <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                        <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                    </li>

                    @if (CurrentPage <= 3)
                    {
                        // Tampilkan halaman 2 sampai 4
                        for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    else if (CurrentPage >= TotalPages - 2)
                    {
                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        for (int i = TotalPages - 3; i < TotalPages; i++)
                        {
                            if (i > 1)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }
                        }
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>

                        for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    @if (TotalPages > 1)
                    {
                        <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                        </li>
                    }

                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                        <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }

        @if (ShowAddStudentToMentorModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Pilih Siswa</p>
                        <div class="mb-3">
                            <input class="form-control w-75 mx-auto"
                                   placeholder="Search..."
                                   @bind="AddStudentSearchText"
                                   @oninput="OnAddStudentSearchChanged" />
                        </div>
                        @if (IsLoadingStudents)
                        {
                            <div class="my-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 text-start" style="max-height:300px;overflow-y:auto;">
                                @if (FilteredAvailableStudents.Count == 0)
                                {
                                    <div class="text-center text-muted">Tidak ada siswa PKL tanpa mentor.</div>
                                }
                                else
                                {
                                    @foreach (var student in FilteredAvailableStudents)
                                    {
                                        <div class="form-check ms-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="student_@student.id"
                                                   checked="@SelectedStudentIds.Contains(student.id)"
                                                   @onchange="e => OnStudentCheckboxChanged(e, student.id)" />
                                            <label class="form-check-label" for="student_@student.id">
                                                @student.nis - @student.fullname
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-danger px-4" @onclick="CancelAddStudentToMentor">Cancel</button>
                    <button class="btn btn-success px-4" @onclick="ConfirmAddStudentToMentor" disabled="@(SelectedStudentIds.Count == 0)">Confirm</button>
                </div>
            </Modal>
        }

        @if (ShowPilihPTModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <h5 class="mb-3 text-center">Pilih Tempat PKL</h5>
                    <div class="mb-3">
                        <input class="form-control w-75 mx-auto"
                               placeholder="Search..."
                               @bind="CompanySearchText"
                               @oninput="OnCompanySearchChanged" />
                    </div>
                    <div style="max-height:300px;overflow-y:auto;">
                        @if (IsLoadingCompanies)
                        {
                            <div class="text-center my-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 ms-1">
                                @foreach (var company in FilteredCompanies)
                                {
                                    <div class="form-check text-start">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="companyRadio"
                                               id="company_@company.id"
                                               value="@company.id"
                                               checked="@(SelectedCompanyId == company.id)"
                                               @onchange="OnCompanyRadioChanged" />
                                        <label class="form-check-label" for="company_@company.id">
                                            @company.name
                                        </label>
                                    </div>
                                }
                                @if (FilteredCompanies.Count == 0)
                                {
                                    <div class="text-center text-muted">No companies found.</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-3">
                    <button class="btn btn-danger px-4" @onclick="ClosePilihPTModal">Cancel</button>
                    <button class="btn btn-success px-4" @onclick="ConfirmPilihPT" disabled="@(SelectedCompanyId == null)">Confirm</button>
                </div>
            </Modal>
        }

        @if (ShowAddModal)
        {
            <Modal IsVisible="true" Title="Tambah Kelas">
                <div class="modal-scrollable-content">
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label text-start d-block text-start">Kelas</label>
                        <input class="form-control" @bind="NewClass.name" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Total Siswa</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.total_students" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Wali Kelas</label>
                        <select class="form-select" @bind="SelectedWalasId">
                            <option value="">Pilih</option>
                            @foreach (var walas in WalasList)
                            {
                                <option value="@walas.id">@walas.fullname</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Tahun</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.year" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Deskripsi</label>
                        <input class="form-control" @bind="NewClass.description" />
                    </div>
                </div>
                <div class="d-flex justify-content-around">
                    <button class="btn btn-danger px-4" @onclick="CancelAdd">Cancel</button>
                    <button class="btn btn-success px-4" @onclick="ConfirmAdd" disabled="@(IsAddClassValid == false)">Confirm</button>
                </div>
            </Modal>
        }

        @if (ShowAssignModal)
        {
            <Modal IsVisible="true">
                @if (AssignModalState == "empty")
                {
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle fs-1 mb-4 text-danger"></i>
                        <p class="fw-semibold mb-4">Silakan pilih minimal satu siswa terlebih dahulu sebelum melanjutkan.</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Return to List</button>
                    </div>
                }
                else if (AssignModalState == "confirm")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>@AssignModalText</p>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CloseAssignModal">Cancel</button>
                            <button class="btn btn-success px-4" @onclick="ConfirmAssignStudent">Confirm</button>
                        </div>
                    </div>
                }
                else if (AssignModalState == "done")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>Siswa berhasil ditambahkan ke kelas!</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Done</button>
                    </div>
                }
            </Modal>
        }

        @if (ShowDeleteModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    @if (DeleteModalState == "confirm")
                    {
                        <div class="text-center">
                            <i class="bi bi-trash fs-1 mb-3 text-danger"></i>
                            <p class="fw-bold">Hapus Kelas</p>
