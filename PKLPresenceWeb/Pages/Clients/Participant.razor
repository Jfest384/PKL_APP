@attribute [Authorize]
@page "/participant"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HistoryState HistoryState
@inject CompanyState CompanyState
@inject AlertService AlertService
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Globalization

<div class="participant-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Participant</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan"))
        {
            <div class="d-none d-sm-block">
                <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
                    @foreach (var tab in VisibleTabs)
                    {
                        var isMessageTab = tab == "Message";
                        <li class="nav-item flex-fill text-center">
                            <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "") @(isMessageTab && IsMessageTabDisabled ? "disabled" : "")"
                                    style="width:100%;"
                                    @onclick="isMessageTab && IsMessageTabDisabled ? null : (() => ChangeTab(tab))"
                                    disabled="@(isMessageTab && IsMessageTabDisabled)">
                                @tab
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <div class="d-block d-sm-none mb-3">
                <select class="form-select tab-dropdown-fill" @onchange="OnTabDropdownChanged" value="@CurrentTab">
                    @foreach (var tab in VisibleTabs)
                    {
                        <option value="@tab" disabled="@(tab == "Message" && IsMessageTabDisabled)">@tab</option>
                    }
                </select>
            </div>
        }
        else
        {
            <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
                @foreach (var tab in VisibleTabs)
                {
                    var isMessageTab = tab == "Message";
                    <li class="nav-item flex-fill text-center">
                        <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "") @(isMessageTab && IsMessageTabDisabled ? "disabled" : "")"
                                style="width:100%;"
                                @onclick="isMessageTab && IsMessageTabDisabled ? null : (() => ChangeTab(tab))"
                                disabled="@(isMessageTab && IsMessageTabDisabled)">
                            @tab
                        </button>
                    </li>
                }
            </ul>
        }

        @if (UserRole != "Student" && CurrentTab != "Pembimbing PKL" && CurrentTab != "Manajemen Kelas" && CurrentTab != "Daftar PT" && CurrentTab != "Message")
        {
            <div class="row g-2 mb-3 align-items-center">
                <div class="col">
                    <input class="form-control" placeholder="Search..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in Classes)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
            </div>

            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa TKJ")
            {
                <div class="row mb-3 g-2">
                    <div class="col-12">
                        <div class="d-flex flex-wrap flex-md-nowrap align-items-stretch responsive-btn-group">
                            <div class="d-flex flex-grow-1 gap-2 btn-main-group">
                                <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnAssignStudentPKLClicked">
                                    <i class="bi bi-person-plus"></i> Assign PKL
                                </button>
                                <button class="btn btn-primary flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnAssignClassClicked">
                                    <i class="bi bi-people"></i> Assign Class
                                </button>
                            </div>
                            <div class="d-flex gap-2 ms-auto btn-side-group">
                                <button class="btn btn-success px-3 d-none d-sm-inline" @onclick="() => ShowAddStudentModal = true">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                                <button class="btn btn-danger px-3 d-none d-sm-inline" @onclick="OnDeleteStudentTKJClicked">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end mt-2 d-sm-none">
                            <button class="btn btn-success" style="width:48px;" @onclick="() => ShowAddStudentModal = true">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <button class="btn btn-danger" style="width:48px;" @onclick="OnDeleteStudentTKJClicked">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa PKL")
            {
                <div class="row mb-3 g-2">
                    <div class="col-12">
                        <div class="d-flex flex-wrap flex-md-nowrap align-items-stretch responsive-btn-group">
                            <div class="d-flex flex-grow-1 gap-2 btn-main-group">
                                <button class="btn btn-danger flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnDeleteStudentPKLClicked">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                                <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="OnPublishRecapClicked">
                                    <i class="bi bi-upload"></i> Publish
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @if (CurrentTab == "Manajemen Kelas")
        {
            <div class="row g-2 align-items-center mb-3">
                <div class="col">
                    <input class="form-control search-class-input" placeholder="Nama Kelas..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-primary w-200" @onclick="OnAddClassClicked">
                        <i class="bi bi-plus-lg me-1"></i> Kelas
                    </button>
                </div>
            </div>
        }

        @if (CurrentTab == "Daftar PT")
        {
            <div class="row g-2 align-items-center mb-3">
                <div class="col">
                    <input class="form-control search-class-input" placeholder="Nama PT..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-primary w-200" @onclick="ShowAddCompanyModal">
                        <i class="bi bi-plus-lg me-1"></i> Company
                    </button>
                </div>
            </div>
        }

        @if (CurrentTab == "Pembimbing PKL" && (UserRole == "Admin" || UserRole == "Kepala Jurusan"))
        {
            <div class="row g-2 mb-3 align-items-center">
                <div class="col">
                    <input class="form-control" placeholder="Search Mentor..." @bind="MentorSearchText" @oninput="OnMentorDataSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-success" @onclick="OpenAddMentorModal">
                        <i class="bi bi-person-plus"></i> Mentor
                    </button>
                </div>
            </div>
        }

        @if (CurrentTab == "Message")
        {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="section-title">Whatsapp Management</div>
                <button class="btn btn-sm btn-warning p-2"
                        style="min-height: 30px; min-width: 30px;"
                        @onclick="OnSendReminderClicked"
                        disabled="@(DefaultChats == null || DefaultChats.Count == 0)">
                    <i class="bi bi-bell mx-1"></i>
                    <span class="message-action-btn-text me-1">Send Reminder</span>
                </button>
            </div>
            <div class="student-detail-card mb-4">
                <div class="student-detail-header">WAHA Session</div>
                @if (WahaSession?.me == null || WahaSession?.engine == null)
                {
                    <p class="text-center text-muted mt-2">Loading session data...</p>
                }
                else
                {
                    <div class="student-detail-body">
                        <div class="student-detail-col student-detail-col-left">
                            <div class="student-detail-row">
                                <label class="student-detail-label">Name</label>
                                <input class="student-detail-input" value="@WahaSession?.name" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">Status</label>
                                <input class="student-detail-input fw-bold text-success" value="@WahaSession?.status" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">Config</label>
                                <input class="student-detail-input"
                                       value="@(WahaSession?.config?.ToString() ?? "-")" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">Me (id)</label>
                                <input class="student-detail-input" value="@WahaSession?.me.id" readonly />
                            </div>
                        </div>
                        <div class="student-detail-col student-detail-col-right">
                            <div class="student-detail-row">
                                <label class="student-detail-label">Me (name)</label>
                                <input class="student-detail-input" value="@WahaSession?.me.pushName" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">Engine</label>
                                <input class="student-detail-input" value="@WahaSession?.engine.engine" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">WWebVersion</label>
                                <input class="student-detail-input" value="@WahaSession?.engine.WWebVersion" readonly />
                            </div>
                            <div class="student-detail-row">
                                <label class="student-detail-label">Engine State</label>
                                <input class="student-detail-input fw-bold text-success" value="@WahaSession?.engine.state" readonly />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="student-detail-card mb-4">
                <div class="student-detail-header d-flex justify-content-between align-items-center">
                    <span>Default Chat</span>
                    <button class="btn btn-sm btn-outline-primary" @onclick="OpenDefaultChatSettingsModal">
                        <i class="bi bi-gear"></i> Settings
                    </button>
                </div>
                <div class="student-detail-body">
                    @if (IsLoadingDefaultChats)
                    {
                        <div class="text-center my-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (DefaultChats.Count == 0)
                    {
                        <div class="text-center text-muted">Tidak ada data Default Chat.</div>
                    }
                    else
                    {
                        <div class="scrollable-x">
                            <table class="table table-bordered message">
                                <thead>
                                    <tr>
                                        <th class="text-center">Service</th>
                                        <th class="text-center">Chat ID</th>
                                        <th class="text-center">Chat Name</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < DefaultChats.Count; i++)
                                    {
                                        var chat = DefaultChats[i];
                                        <tr>
                                            <td class="text-center">@chat.ServiceName</td>
                                            <td>
                                                @string.Join(", ", chat.IdChat)
                                            </td>
                                            <td>
                                                @string.Join(", ", chat.ChatName)
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-success me-1"
                                                        @onclick="() => SendTestTemplateAsync(chat)"
                                                        disabled="@(SendingTestDefaultChatId == chat.Id)">
                                                    <i class="bi bi-info-circle"></i>
                                                    <span class="message-action-btn-text ms-1">Test</span>
                                                </button>
                                                <button class="btn btn-sm btn-warning me-1" @onclick="() => OnEditDefaultChat(chat)">
                                                    <i class="bi bi-pencil"></i>
                                                    <span class="message-action-btn-text ms-1">Edit</span>
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => OnClearDefaultChat(chat)">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="message-action-btn-text ms-1">Clear</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (CurrentTab != "Message")
        {
            <div class="scrollable-x">
                <table class="table table-bordered @GetTableCode()">
                    <thead>
                        <tr>
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                            {
                                <th class="text-center">
                                    <input type="checkbox" @bind="IsHeaderCheckboxChecked" />
                                </th>
                            }
                            <th class="text-center">No</th>
                            @foreach (var header in GetHeaders())
                            {
                                var sortable = false;
                                if (CurrentTab == "Siswa TKJ" && (header == "NIS" || header == "Nama" || header == "Kelas")) sortable = true;
                                else if (CurrentTab == "Pembimbing PKL" && (header == "Nama" || header == "NIP")) sortable = true;
                                else if (CurrentTab == "Siswa PKL" && (header == "NIS" || header == "Nama" || header == "Kelas" || header == "Pembimbing" || header == "Tempat PKL")) sortable = true;
                                else if (CurrentTab == "Manajemen Kelas" && (header == "Kelas" || header == "Total Siswa" || header == "Wali Kelas" || header == "Tahun")) sortable = true;
								else if (CurrentTab == "Daftar PT" && (header == "Nama")) sortable = true;

                                <th class="text-center @(sortable ? "sortable" : "")"
                                    @onclick="sortable ? (() => SortBy(header)) : null"
                                    style="cursor:@(sortable ? "pointer" : "default")">
                                    @header
                                    @if (SortColumn == header)
                                    {
                                        <span class="part-sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                            }
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") ||
                            ((CurrentTab == "Siswa PKL" || CurrentTab == "Siswa TKJ") && (UserRole == "Mentor" || UserRole == "Wali Kelas" || UserRole == "Wali Kelas & Mentor")))
                            {
                                <th class="text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (GetPagedSortedData().Count == 0)
                        {
                            int colspan = 0;
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                                colspan += 1;
                            colspan += 1;
                            colspan += GetHeaders().Count;
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") ||
                            (CurrentTab == "Siswa PKL" && (UserRole == "Mentor" || UserRole == "Wali Kelas" || UserRole == "Wali Kelas & Mentor")))
                                colspan += 1;

                            <tr>
                                <td colspan="@colspan" class="text-center text-muted">
                                    Tidak ada data @(CurrentTab).
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize;
                            @foreach (var item in GetPagedSortedData())
                            {
                                rowIndex++;
                                <tr>
                                    @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan") && (CurrentTab == "Siswa TKJ" || CurrentTab == "Siswa PKL"))
                                    {
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   checked="@SelectedSiswaPKLIds.Contains(int.Parse(item[0]))"
                                                   @onchange="e => OnRowCheckboxChanged(e, item)" />
                                        </td>
                                    }
                                    <td class="text-center">@rowIndex</td>
                                    @if (CurrentTab == "Siswa TKJ")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        @if (UserRole != "Teacher")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success"
                                                            @onclick="() => OnShowStudentDetail(int.Parse(item[0]))">
                                                        <i class="bi bi-info-circle me-1"></i> Detail
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Pembimbing PKL")
                                    {
                                        @if (UserRole != "Student")
                                        {
                                            <td>@item[1]</td>
                                        }
                                        <td>@item[2]</td>
                                        <td>
                                            @{
                                                var kelasDibimbing = string.IsNullOrWhiteSpace(item[3]) ? "-" : item[3];
                                            }
                                            @kelasDibimbing
                                        </td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex flex-column gap-2 align-items-center">
                                                    <button class="btn btn-sm btn-warning" style="padding-left: 0.6rem; padding-right: 0.6rem;"
                                                            @onclick="() => OnAddStudentToMentor(item)">
                                                        <i class="bi bi-plus-lg"></i> Tambah Siswa
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteMentorClicked(item)">
                                                        <i class="bi bi-trash"></i> Delete Mentor
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Siswa PKL")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>
                                            @{
                                                var tempatPKL = string.IsNullOrWhiteSpace(item[5]) ? "-" : item[5];
                                            }
                                            @tempatPKL
                                        </td>
                                        @if (UserRole != "Teacher" || UserRole != "Student")
                                        {
                                            <td>
                                                @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                                {
                                                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center presence-action-group" style="min-width:120px;">
                                                        <div class="action-grid">
                                                            <button class="btn btn-sm @(string.IsNullOrWhiteSpace(item[5]) || item[5] == "-" ? "btn-info" : "btn-success")"
                                                                    @onclick="() => OnPilihTempatPKL(item)">
                                                                <i class="bi bi-geo-alt"></i>
                                                                <span class="btn-text-sm-hide ms-1">Lokasi PKL</span>
                                                            </button>
                                                            <button class="btn btn-sm btn-primary"
                                                                    @onclick="() => GoToHistory(item)">
                                                                <i class="bi bi-clock-history"></i>
                                                                <span class="btn-text-sm-hide ms-1">History</span>
                                                            </button>
                                                            <button class="btn btn-sm btn-warning"
                                                                    @onclick="() => OnShowResetLocationModal(item)">
                                                                <i class="bi bi-arrow-repeat"></i>
                                                                <span class="btn-text-sm-hide ms-1">Location</span>
                                                            </button>
                                                            <label class="horizontal-switch">
                                                                <input type="checkbox"
                                                                       checked="@GetStudentLockStatus(int.Parse(item[0]))"
                                                                       @onchange="e => OnLockSliderChanged(int.Parse(item[0]), GetStudentLockStatus(int.Parse(item[0])))" />
                                                                <span class="horizontal-slider">
                                                                    <span class="slider-knob">
                                                                        <span class="slider-text">
                                                                            @(GetStudentLockStatus(int.Parse(item[0])) ? "ON" : "OFF")
                                                                        </span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex d-sm-none flex-column align-items-center gap-1 mobile-pkl-action">
                                                        <div class="d-flex gap-2 justify-content-center w-100">
                                                            <button class="btn btn-sm @(string.IsNullOrWhiteSpace(item[5]) || item[5] == "-" ? "btn-info" : "btn-success")"
                                                                    title="Lokasi PKL"
                                                                    @onclick="() => OnPilihTempatPKL(item)">
                                                                <i class="bi bi-geo-alt"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-primary" title="History"
                                                                    @onclick="() => GoToHistory(item)">
                                                                <i class="bi bi-clock-history"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-warning" title="Location"
                                                                    @onclick="() => OnShowResetLocationModal(item)">
                                                                <i class="bi bi-arrow-repeat"></i>
                                                            </button>
                                                        </div>
                                                        <div class="d-flex justify-content-center w-100">
                                                            <label class="horizontal-switch mobile-switch">
                                                                <input type="checkbox"
                                                                       checked="@GetStudentLockStatus(int.Parse(item[0]))"
                                                                       @onchange="e => OnLockSliderChanged(int.Parse(item[0]), GetStudentLockStatus(int.Parse(item[0])))" />
                                                                <span class="horizontal-slider">
                                                                    <span class="slider-knob">
                                                                        <span class="slider-text">
                                                                            @(GetStudentLockStatus(int.Parse(item[0])) ? "ON" : "OFF")
                                                                        </span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                                else if (UserRole == "Mentor" || UserRole == "Wali Kelas" || (UserRole == "Mentor" && UserRole == "Wali Kelas"))
                                                {
                                                    <div class="d-flex gap-2 justify-content-center">
                                                        <button class="btn btn-sm btn-primary" @onclick="() => GoToHistory(item)">
                                                            <i class="bi bi-clock-history me-1"></i>History
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Manajemen Kelas")
                                    {
                                        <td>@item[1]</td>
                                        <td>
                                            @{
                                                var classId = int.Parse(item[0]);
                                                int total = StudentCountPerClass.TryGetValue(classId, out var count) ? count : 0;
                                            }
                                            @total
                                        </td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>@item[5]</td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <button class="btn btn-sm btn-success" @onclick="() => OnAssignClassToStudents(int.Parse(item[0]), item[1])">
                                                    <i class="bi bi-person-plus"></i>
                                                    <span class="btn-text-sm-hide ms-1">Siswa</span>
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClassClicked(item)">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="btn-text-sm-hide ms-1">Kelas</span>
                                                </button>
                                                <button class="btn btn-sm btn-warning" @onclick="() => OnEditClassClicked(Classrooms.FirstOrDefault(c => c.id == int.Parse(item[0])))">
                                                    <i class="bi bi-pencil"></i>
                                                    <span class="btn-text-sm-hide ms-1">Edit</span>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                    else if (CurrentTab == "Daftar PT")
                                    {
                                        <td>@item[1]</td>
                                        <td>
