                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-danger px-4" @onclick="CancelResetLocation">No</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmResetLocation">Yes</button>
                    </div>
                </div>
            </Modal>
        }
    </div>
</div>

