                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <textarea class="form-control mx-2 text-center" style="width:270px;" rows="1" readonly>@CurrentReminderChatName</textarea>
                        <button class="chevron-date-btn"
                                @onclick="NextReminderChat" disabled="@(CurrentReminderIndex == ReminderChatNamesList.Count - 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <div class="text-start fw-bold mb-1">Message</div>
                    <textarea class="form-control mb-1" rows="6"
                              @bind="ReminderMessageRaw"
                              @bind:event="oninput"
                              @onchange="OnReminderMessageChanged"></textarea>
                    <span class="text-danger">*Jangan menghapus kurung siku!</span>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-3">
                    <button class="btn btn-danger px-4" @onclick="CancelSendReminder">Cancel</button>
                    <button class="btn btn-success px-4 d-flex align-items-center" @onclick="SendReminderAsync" disabled="@IsSendingReminder">
                        <i class="bi bi-whatsapp me-2"></i> Send
                    </button>
                </div>
                @if (IsSendingReminder)
                {
                    <div class="text-center my-2">
                        <span class="spinner-border text-success" role="status"></span>
                    </div>
                }
            </Modal>
        }

        @if (ShowCompanyModal)
        {
            <Modal IsVisible="true" Title="@(ShowCompanyModalMode == "add" ? "Tambah Perusahaan" : "Edit Perusahaan")">
                <div class="modal-scrollable-content">
                    <div class="mx-1 mt-1">
                        <div class="mb-3">
                            <label class="form-label text-start d-block">Perusahaan</label>
                            <textarea class="form-control" placeholder="Nama Perusahaan..."
                                      @bind="NewCompany.Name" rows="1"></textarea>
                        </div>

                        @if (ShowCompanyModalMode == "add")
                        {
                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                <label class="form-label mb-0">Lokasi</label>
                                <button class="btn btn-outline-primary btn-sm" @onclick="OpenGoogleMaps">
                                    <i class="bi bi-geo-alt-fill me-1"></i> Google Maps
                                </button>
                            </div>
                            <div id="companyMap" style="height: 130px; border-radius: 8px; border: 1px solid #ccc;"></div>
                            <div class="text-muted text-start mt-2" style="font-size: 14px;">
                                <div>* Lihat Koordinat Perusahaan melalui Google Maps</div>
                            </div>
                            <div class="my-2">
                                <label class="form-label d-block text-start">Koordinat</label>
                                <textarea id="company-coord"
                                          class="form-control"
                                          placeholder="-6.2000000, 106.8166660"
                                          @bind-value="CoordinateInput"
                                          @bind-value:event="oninput"
                                          @onchange="OnCoordinateChanged"
                                          rows="1">
                                            </textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label d-block text-start">Alamat</label>
                                <textarea id="company-address"
                                          class="form-control"
                                          rows="2"
                                          @bind="NewCompany.Address"
                                          @onfocus="OnAddressClicked"
                                          @onclick="OnAddressClicked">
                                        </textarea>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-around">
                    <button class="btn btn-danger px-4" @onclick="CancelAddCompany">Cancel</button>
                    <button class="btn btn-success px-4" @onclick="ConfirmAddCompany" disabled="@(!IsCompanyValid)">
                        Confirm
                    </button>
                </div>
            </Modal>
        }

        @if (ShowResetLocationModal)
        {
            <Modal IsVisible="true">
                <div class="text-center">
                    <i class="bi bi-arrow-repeat fs-1 text-warning checkmark-animate"></i>
                    <p class="fw-bold">Reset Location</p>
                    <p>Apakah Anda yakin ingin mereset Lokasi Presensi milik siswa <span class="fw-bold">@ResetLocationStudentName</span>?</p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-danger px-4" @onclick="CancelResetLocation">No</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmResetLocation">Yes</button>
                    </div>
                </div>
            </Modal>
        }
    </div>
</div>