@page "/participant"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using PKLPresenceWeb.Model
@using System.Net.Http.Headers

<div class="participant-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Participant</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
            @foreach (var tab in VisibleTabs)
            {
                <li class="nav-item flex-fill text-center">
                    <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "")" style="width:100%;" @onclick="() => ChangeTab(tab)">@tab</button>
                </li>
            }
        </ul>

        @if (UserRole != "Student" && CurrentTab != "Pembimbing PKL" && CurrentTab != "Manajemen Kelas")
        {
            <div class="row g-2 mb-3">
                <div class="col">
                    <input class="form-control" placeholder="Search..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in Classes)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (CurrentTab == "Manajemen Kelas")
        {
            <div class="row g-2 align-items-center mb-3">
                <div class="col">
                    <input class="form-control search-class-input" placeholder="Nama Kelas..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <div class="col-auto ms-auto">
                    <button class="btn btn-warning w-200" @onclick="() => ShowAddModal = true">
                        <i class="bi bi-plus-lg me-1"></i> Tambah Kelas
                    </button>
                </div>
            </div>
        }

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="scrollable-x">
                <table class="table table-bordered @GetTableCode()">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            @foreach (var header in GetHeaders())
                            {
                                <th class="text-center">@header</th>
                            }
                            @if ((UserRole == "Admin" || UserRole == "Kepala Jurusan"))
                            {
                                <th class="text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (GetCurrentData().Count == 0)
                        {
                            var showAction = (UserRole == "Admin" || UserRole == "Kepala Jurusan") && CurrentTab == "Siswa PKL";
                            var colspan = 1 + GetHeaders().Count + (showAction ? 1 : 0);
                            <tr>
                                <td colspan="@colspan" class="text-center text-muted">
                                    Tidak ada data @(CurrentTab).
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (CurrentPage - 1) * 10; // 10 = page size, sesuaikan jika page size dinamis
                            @foreach (var item in GetCurrentData())
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    @if (CurrentTab == "Siswa TKJ")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success"
                                                            @onclick="() => NavigateToClassManagement(item)">
                                                        <i class="bi bi-person-plus"></i> ke Kelas
                                                    </button>
                                                    <button class="btn btn-sm btn-warning"
                                                            @onclick="() => ConfirmAddToPkl(item)"
                                                            disabled="@(IsStudentInPKL(int.Parse(item[0])))">
                                                        <i class="bi bi-person-plus"></i> ke Siswa PKL
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Pembimbing PKL")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td class="justify-content-center">
                                                <button class="btn btn-sm btn-warning" @onclick="() => OnAddStudentToMentor(item)">
                                                    <i class="bi bi-plus-lg me-1"></i> Tambah Siswa
                                                </button>
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Siswa PKL")
                                    {
                                        <td>@item[1]</td>
                                        <td>@item[2]</td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>
                                            @{
                                                var tempatPKL = string.IsNullOrWhiteSpace(item[5]) ? "-" : item[5];
                                            }
                                            @tempatPKL
                                        </td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(item[5]) || item[5] == "-")
                                                {
                                                    <button class="btn btn-sm btn-warning" @onclick="() => OnPilihTempatPKL(item)">
                                                        Pilih Tempat PKL
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => OnPilihTempatPKL(item)">
                                                        Ubah Tempat PKL
                                                    </button>
                                                }
                                            </td>
                                        }
                                    }
                                    else if (CurrentTab == "Manajemen Kelas")
                                    {
                                        // item[0] = classId, item[1] = name, dst.
                                        <td>@item[1]</td>
                                        <td>
                                            @{
                                                var classId = int.Parse(item[0]);
                                                int total = StudentCountPerClass.TryGetValue(classId, out var count) ? count : 0;
                                            }
                                            @total
                                        </td>
                                        <td>@item[3]</td>
                                        <td>@item[4]</td>
                                        <td>@item[5]</td>
                                        @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                                        {
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <button class="btn btn-sm btn-success" @onclick="() => OnAssignStudent(int.Parse(item[0]), item[1])">
                                                        <i class="bi bi-person-plus"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClass(int.Parse(item[0]), item[1])">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                <ul class="pagination d-flex flex-wrap justify-content-center">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                        <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                    </li>

                    @* Selalu tampilkan page 1 *@
                    <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                        <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                    </li>

                    @if (CurrentPage <= 3)
                    {
                        // Tampilkan halaman 2 sampai 4
                        for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    else if (CurrentPage >= TotalPages - 2)
                    {
                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        for (int i = TotalPages - 3; i < TotalPages; i++)
                        {
                            if (i > 1)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }
                        }
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>

                        for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    @if (TotalPages > 1)
                    {
                        <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                        </li>
                    }

                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                        <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }

        @if (ShowConfirmationModal)
        {
            <Modal IsVisible="ShowConfirmationModal">
                <div class="text-center">
                    <i class="bi bi-person-plus fs-1"></i>
                    <p class="fw-bold">Tambahkan Siswa</p>
                    <p>@ConfirmationText</p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        @if (ConfirmButtonText != "Done")
                        {
                            <button class="btn btn-danger px-4" @onclick="CancelModal">Cancel</button>
                        }
                        <button class="btn btn-primary px-4" @onclick="ConfirmAssignPkl">@ConfirmButtonText</button>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowAddStudentToMentorModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Pilih Siswa</p>
                        @if (IsLoadingStudents)
                        {
                            <div class="my-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3 text-start" style="max-height:300px;overflow-y:auto;">
                                @if (AvailableStudents.Count == 0)
                                {
                                    <div class="text-center text-muted">Tidak ada siswa PKL tanpa mentor.</div>
                                }
                                else
                                {
                                    @foreach (var student in AvailableStudents)
                                    {
                                        <div class="form-check ms-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="student_@student.id"
                                                   checked="@SelectedStudentIds.Contains(student.id)"
                                                   @onchange="e => OnStudentCheckboxChanged(e, student.id)" />
                                            <label class="form-check-label" for="student_@student.id">
                                                @student.nis - @student.fullname
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CancelAddStudentToMentor">Cancel</button>
                            <button class="btn btn-success px-4" @onclick="ConfirmAddStudentToMentor" disabled="@(SelectedStudentIds.Count == 0)">Confirm</button>
                        </div>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowPilihPTModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    <h5 class="mb-3 text-center">Pilih Tempat PKL</h5>
                    @if (IsLoadingCompanies)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 ms-1">
                            @foreach (var company in Companies)
                            {
                                <div class="form-check text-start">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="companyRadio"
                                           id="company_@company.id"
                                           value="@company.id"
                                           checked="@(SelectedCompanyId == company.id)"
                                           @onchange="OnCompanyRadioChanged" />
                                    <label class="form-check-label" for="company_@company.id">
                                        @company.name
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-danger px-4" @onclick="ClosePilihPTModal">Cancel</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmPilihPT" disabled="@(SelectedCompanyId == null)">Confirm</button>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowAddModal)
        {
            <Modal IsVisible="true" Title="Tambahkan Kelas">
                <div class="modal-scrollable-content">
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label text-start d-block text-start">Kelas</label>
                        <input class="form-control" @bind="NewClass.name" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Total Siswa</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.total_students" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Wali Kelas</label>
                        <select class="form-select" @bind="SelectedWalasId">
                            <option value="">Pilih</option>
                            @foreach (var walas in WalasList)
                            {
                                <option value="@walas.id">@walas.fullname</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Tahun</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.year" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Deskripsi</label>
                        <input class="form-control" @bind="NewClass.description" />
                    </div>
                    <div class="d-flex justify-content-around mt-4">
                        <button class="btn btn-danger px-4" @onclick="CancelAdd">Cancel</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmAdd" disabled="@(IsAddClassValid == false)">Confirm</button>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowAssignModal)
        {
            <Modal IsVisible="true">
                @if (AssignModalState == "empty")
                {
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle fs-1 mb-4 text-danger"></i>
                        <p class="fw-semibold mb-4">Silakan pilih minimal satu siswa terlebih dahulu sebelum melanjutkan.</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Return to List</button>
                    </div>
                }
                else if (AssignModalState == "confirm")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>@AssignModalText</p>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CloseAssignModal">Cancel</button>
                            <button class="btn btn-success px-4" @onclick="ConfirmAssignStudent">Confirm</button>
                        </div>
                    </div>
                }
                else if (AssignModalState == "done")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>Siswa berhasil ditambahkan ke kelas!</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Done</button>
                    </div>
                }
            </Modal>
        }

        @if (ShowDeleteModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    @if (DeleteModalState == "confirm")
                    {
                        <div class="text-center">
                            <i class="bi bi-trash fs-1 mb-3 text-danger"></i>
                            <p class="fw-bold">Hapus Kelas</p>
                            <p>@DeleteModalText</p>
                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <button class="btn btn-warning px-4" @onclick="CloseDeleteModal">Cancel</button>
                                <button class="btn btn-danger px-4" @onclick="ConfirmDeleteClass">Confirm</button>
                            </div>
                        </div>
                    }
                    else if (DeleteModalState == "done")
                    {
                        <div class="text-center">
                            <i class="bi bi-trash fs-1 mb-3 text-danger"></i>
                            <p class="fw-bold">Hapus Kelas</p>
                            <p>@DeleteModalText</p>
                            <button class="btn btn-primary px-4" @onclick="CloseDeleteModal">Done</button>
                        </div>
                    }
                </div>
            </Modal>
        }
    </div>
</div>

@code {
    private string UserRole = "";
    private string SearchText = "";
    private int? SelectedClassId;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private bool IsLoading = false;

    private List<ClassItem> Classes = new();
    private List<string> VisibleTabs = new();
    private string CurrentTab = "";

    private List<StudentItem> Students = new();
    private List<MentorItem> Mentors = new();
    private List<StudentPKLItem> StudentPKLs = new();
    private List<ClassItem> Classrooms = new();

    private CancellationTokenSource? searchDebounceCts;

    bool ShowAddStudentToMentorModal = false;
    int? SelectedMentorId;
    string? SelectedMentorName;
    List<StudentPKLItem> AvailableStudents = new();
    HashSet<int> SelectedStudentIds = new();
    bool IsLoadingStudents = false;

    // Modal Pilih PT
    bool ShowPilihPTModal = false;
    int? SelectedStudentIdForPT = null;
    int? SelectedCompanyId = null;
    List<CompanyItem> Companies = new();
    bool IsLoadingCompanies = false;

    private bool ShowAddModal = false;
    private NewClass NewClass = new()
    {
        name = string.Empty,
        total_students = 0,
        WaliKelasid = 0,
        year = DateTime.Now.Year,
        description = string.Empty
    };
    private int? SelectedWalasId;
    private List<WalasItem> WalasList = new();
    private bool IsAddClassValid =>
        !string.IsNullOrWhiteSpace(NewClass.name)
        && NewClass.total_students > 0
        && SelectedWalasId.HasValue
        && NewClass.year > 0
        && !string.IsNullOrWhiteSpace(NewClass.description);

    private async void ConfirmAdd()
    {
        if (SelectedWalasId.HasValue)
        {
            NewClass.WaliKelasid = SelectedWalasId.Value;
            var res = await Http.PostAsJsonAsync(APIUrl.Endpoint("classes"), NewClass);
            if (res.IsSuccessStatusCode)
            {
                ShowAddModal = false;
                NewClass = new()
                {
                    name = string.Empty,
                    total_students = 0,
                    WaliKelasid = 0,
                    year = DateTime.Now.Year,
                    description = string.Empty
                };
                await LoadData();
            }
        }
    }

    private void CancelAdd()
    {
        NewClass = new()
        {
            name = string.Empty,
            total_students = 0,
            WaliKelasid = 0,
            year = DateTime.Now.Year,
            description = string.Empty
        };
        SelectedWalasId = null;
        ShowAddModal = false;
    }

    private bool ShowAssignModal = false;
    private string AssignModalState = ""; // "empty", "confirm", "done"
    private string AssignModalText = "";
    private int? SelectedClassIdForAssign;
    //private int? SelectedStudentId;
    private string? SelectedStudentStatus;

    private bool ShowDeleteModal = false;
    private string DeleteModalState = ""; // "confirm", "done"
    private string DeleteModalText = "";
    private int? SelectedClassIdForDelete;
    private string? SelectedClassNameForDelete;
    private Dictionary<int, int> StudentCountPerClass = new();

    void OnAssignStudent(int classId, string className)
    {
        SelectedClassIdForAssign = classId;

        if (SelectedStudentId == null || string.IsNullOrEmpty(SelectedStudentStatus))
        {
            // Pop up kiri: tidak ada data siswa
            AssignModalState = "empty";
            AssignModalText = "Silakan pilih minimal satu siswa terlebih dahulu sebelum melanjutkan.";
        }
        else
        {
            // Pop up tengah: konfirmasi
            AssignModalState = "confirm";
            AssignModalText = $"Apakah Anda yakin ingin menambahkan Siswa ini ke Kelas {className}?";
        }
        ShowAssignModal = true;
    }

    async Task ConfirmAssignStudent()
    {
        if (AssignModalState == "confirm" && SelectedStudentId.HasValue && SelectedClassIdForAssign.HasValue)
        {
            var payload = new { isPKL = SelectedStudentStatus == "True", idClass = SelectedClassIdForAssign.Value };
            var response = await Http.PutAsJsonAsync(APIUrl.Endpoint($"assign/{SelectedStudentId}"), payload);

            if (response.IsSuccessStatusCode)
            {
                // Pop up kanan: sukses
                AssignModalState = "done";
                AssignModalText = $"Siswa berhasil ditambahkan ke kelas!";
            }
        }
    }

    void CloseAssignModal()
    {
        ShowAssignModal = false;

        Navigation.NavigateTo("/participant", forceLoad: true);
    }

    void OnDeleteClass(int classId, string className)
    {
        SelectedClassIdForDelete = classId;
        SelectedClassNameForDelete = className;
        DeleteModalState = "confirm";
        DeleteModalText = $"Apakah Anda yakin ingin menghapus kelas {className}?";
        ShowDeleteModal = true;
    }

    async Task ConfirmDeleteClass()
    {
        if (DeleteModalState == "confirm" && SelectedClassIdForDelete.HasValue)
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, APIUrl.Endpoint($"classes/{SelectedClassIdForDelete}"));
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                DeleteModalState = "done";
                DeleteModalText = $"Kelas {SelectedClassNameForDelete} berhasil di hapus dari Manajemen Kelas!";
                await LoadData();
            }
        }
    }

    void CloseDeleteModal()
    {
        ShowDeleteModal = false;
        SelectedClassIdForDelete = null;
        SelectedClassNameForDelete = null;
        DeleteModalState = "";
        DeleteModalText = "";
    }

    private async Task LoadWalas()
    {
        WalasList = await Http.GetFromJsonAsync<List<WalasItem>>(APIUrl.Endpoint("data/walas"));
    }

    private async Task<List<StudentItem>> GetAllStudentsAsync()
    {
        var allStudents = new List<StudentItem>();
        int page = 1;
        int totalPages = 1;
        do
        {
            var res = await Http.GetFromJsonAsync<StudentListResponse>(APIUrl.Endpoint($"students?page={page}"));
            if (res?.students != null)
                allStudents.AddRange(res.students);
            totalPages = res?.totalPages ?? 1;
            page++;
        } while (page <= totalPages);
        return allStudents;
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        var user = await Http.GetFromJsonAsync<UserResponse>(APIUrl.Endpoint("me"));
        UserRole = user?.role ?? "";

        // ===== Ambil foto profile =====
        var photoRequest = new HttpRequestMessage(HttpMethod.Get, APIUrl.Endpoint("me/photo"));
        photoRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var photoResponse = await Http.SendAsync(photoRequest);

        if (photoResponse.IsSuccessStatusCode)
        {
            var bytes = await photoResponse.Content.ReadAsByteArrayAsync();
            var contentType = photoResponse.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            var base64 = Convert.ToBase64String(bytes);
            photoUrl = $"data:{contentType};base64,{base64}";
        }

        if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
        {
            await LoadClasses();
            VisibleTabs = new() { "Siswa TKJ", "Pembimbing PKL", "Siswa PKL", "Manajemen Kelas" };
        }
        else if (UserRole == "Student")
            VisibleTabs = new() { "Siswa PKL", "Pembimbing PKL" };
        else
        {
            await LoadClasses();
            VisibleTabs = new() { "Siswa TKJ", "Pembimbing PKL", "Siswa PKL" };
        }

        CurrentTab = VisibleTabs.FirstOrDefault() ?? "";
        await LoadWalas();
        await LoadData();
    }

    private async Task LoadClasses()
    {
        var response = await Http.GetFromJsonAsync<ClassListResponse>(APIUrl.Endpoint($"classes?page={CurrentPage}"));
        if (response != null)
        {
            Classes = response.classrooms ?? new();
            TotalPages = response.totalPages;
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        string url = "";

        if (CurrentTab == "Siswa TKJ")
        {
            url = APIUrl.Endpoint($"students?page={CurrentPage}");
            if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&name={SearchText}";
            if (SelectedClassId.HasValue) url += $"&id_class={SelectedClassId}";

            var res = await Http.GetFromJsonAsync<StudentListResponse>(url);
            Students = res?.students ?? new();
            TotalPages = res?.totalPages ?? 1;

            // Ambil semua siswa PKL dari semua halaman
            StudentPKLs = await GetAllStudentPKLsAsync();
        }
        else if (CurrentTab == "Pembimbing PKL")
        {
            url = APIUrl.Endpoint($"mentors?page={CurrentPage}");
            var res = await Http.GetFromJsonAsync<MentorListResponse>(url);
            Mentors = res?.data ?? new();
            int totalItems = res?.totalItems ?? 0;
            TotalPages = (int)Math.Ceiling(totalItems / 10.0);
        }
        else if (CurrentTab == "Siswa PKL")
        {
            url = APIUrl.Endpoint($"students/pkl?page={CurrentPage}");
            if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&name={SearchText}";
            if (SelectedClassId.HasValue) url += $"&id_class={SelectedClassId}";

            var res = await Http.GetFromJsonAsync<StudentPKLListResponse>(url);
            StudentPKLs = res?.students ?? new();
            TotalPages = res?.totalPages ?? 1;
        }
        else if (CurrentTab == "Manajemen Kelas")
        {
            url = APIUrl.Endpoint($"classes?page={CurrentPage}");
            if (!string.IsNullOrWhiteSpace(SearchText)) url += $"&name={SearchText}";
            var res = await Http.GetFromJsonAsync<ClassListResponse>(url);
            Classrooms = res?.classrooms ?? new();
            TotalPages = res?.totalPages ?? 1;

            // Ambil data siswa untuk menghitung total siswa per kelas
            var students = await GetAllStudentsAsync();
            StudentCountPerClass = students
                .GroupBy(s => s.classroomid)
                .ToDictionary(g => g.Key, g => g.Count());
        }

        IsLoading = false;
        StateHasChanged();
    }

    private bool IsStudentInPKL(int studentId)
    {
        return StudentPKLs.Any(pkl => pkl.id == studentId);
    }

    private async Task ChangeTab(string tab)
    {
        CurrentTab = tab;
        CurrentPage = 1;
        SearchText = string.Empty;
        SelectedClassId = null; // reset juga class id
        ShowConfirmationModal = false;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            CurrentPage = page;
            await LoadData();
        }
    }

    private async void OnClassChange(ChangeEventArgs e)
    {
        SelectedClassId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        CurrentPage = 1;
        await LoadData();
    }

    private async void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        searchDebounceCts?.Cancel();
        searchDebounceCts = new CancellationTokenSource();
        var token = searchDebounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                CurrentPage = 1;
                await LoadData();
            }
        }
        catch (TaskCanceledException) { }
    }

    private List<string[]> GetCurrentData()
    {
        if (CurrentTab == "Siswa TKJ")
            return Students.Select(s => new[] { s.id.ToString(), s.nis, s.fullname, s.class_name, s.classroomid.ToString(), s.isPKL.ToString() }).ToList();
        else if (CurrentTab == "Pembimbing PKL")
            return Mentors.Select(m => new[] { m.id.ToString(), m.fullname, string.Join(", ", m.classes) }).ToList();
        else if (CurrentTab == "Siswa PKL")
            return StudentPKLs.Select(p => new[] { p.id.ToString(), p.nis, p.fullname, p.class_name, p.mentor_name, p.company_name }).ToList();
        else if (CurrentTab == "Manajemen Kelas")
            return Classrooms.Select(c => new[] { c.id.ToString(), c.name, c.students.ToString(), c.walas, c.year.ToString(), c.description }).ToList();

        return new();
    }

    private List<string> GetHeaders()
    {
        if (CurrentTab == "Siswa TKJ") return new() { "NIS", "Nama", "Kelas" };
        if (CurrentTab == "Pembimbing PKL") return new() { "Nama", "Kelas Dibimbing" };
        if (CurrentTab == "Siswa PKL") return new() { "NIS", "Nama", "Kelas", "Pembimbing", "Tempat PKL" };
        if (CurrentTab == "Manajemen Kelas") return new() { "Kelas", "Total Siswa", "Wali Kelas", "Tahun", "Deskripsi" };
        return new();
    }

