@attribute [Authorize]
@page "/participant/class-management"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Model

<div class="class-wrapper">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">Participant</h5>
    </div>

    <div class="content-section">
        <ul class="nav nav-tabs mb-3 d-flex flex-row justify-content-between flex-nowrap">
            @foreach (var tab in VisibleTabs)
            {
                <li class="nav-item flex-fill text-center">
                    <button class="nav-link @(CurrentTab == tab ? "active fw-bold" : "")" style="width:100%;" @onclick="() => ChangeTab(tab)">
                        @tab
                    </button>
                </li>
            }
        </ul>

        <div class="row g-2 align-items-center mb-3">
            <div class="col">
                <input class="form-control search-class-input" placeholder="Nama Kelas..." @bind="SearchText" @oninput="OnSearchChanged" />
            </div>
            <div class="col-auto ms-auto">
                <button class="btn btn-warning w-200" @onclick="() => ShowAddModal = true">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Kelas
                </button>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="scrollable-x">
                <table class="table table-bordered">
                    <thead class="text-center">
                        <tr>
                            <th>No</th>
                            <th>Kelas</th>
                            <th>Total Siswa</th>
                            <th>Wali Kelas</th>
                            <th>Tahun</th>
                            <th>Deskripsi</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Classes is not null && Classes.Count > 0)
                        {
                            var rowIndex = (CurrentPage - 1) * 10;
                            @foreach (var cls in Classes)
                            {
                                rowIndex++;
                                <tr>
                                    <td>@rowIndex</td>
                                    <td>@cls.name</td>
                                    <td>@cls.students siswa</td>
                                    <td>@cls.walas</td>
                                    <td>@cls.year</td>
                                    <td>@cls.description</td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button class="btn btn-sm btn-success" @onclick="() => OnAssignStudent(cls.id, cls.name)">
                                                <i class="bi bi-person-plus"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => OnDeleteClass(cls.id, cls.name)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">Tidak ada data kelas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="d-flex justify-content-center mt-2">
                <ul class="pagination">
                    @if (Classes is null || Classes.Count == 0)
                    {
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                        </li>
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                <button class="page-link"
                                        @onclick="() => ChangePage(pageNum)"
                                        disabled="@(pageNum == CurrentPage)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        </li>
                    }
                </ul>
            </nav>
        }

        @if (ShowAddModal)
        {
            <Modal IsVisible="true" Title="Tambahkan Kelas">
                <div class="modal-scrollable-content">
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label text-start d-block text-start">Kelas</label>
                        <input class="form-control" @bind="NewClass.name" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Total Siswa</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.total_students" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Wali Kelas</label>
                        <select class="form-select" @bind="SelectedWalasId">
                            <option value="">Pilih</option>
                            @foreach (var walas in WalasList)
                            {
                                <option value="@walas.id">@walas.fullname</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Tahun</label>
                        <input class="form-control" type="number" min="1" @bind="NewClass.year" />
                    </div>
                    <div class="mb-3 ms-1 me-1">
                        <label class="form-label d-block text-start">Deskripsi</label>
                        <input class="form-control" @bind="NewClass.description" />
                    </div>
                    <div class="d-flex justify-content-around mt-4">
                        <button class="btn btn-danger px-4" @onclick="CancelAdd">Cancel</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmAdd" disabled="@(IsAddClassValid == false)">Confirm</button>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowAssignModal)
        {
            <Modal IsVisible="true">
                @if (AssignModalState == "empty")
                {
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle fs-1 mb-4 text-danger"></i>
                        <p class="fw-semibold mb-4">Silakan pilih minimal satu siswa terlebih dahulu sebelum melanjutkan.</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Return to List</button>
                    </div>
                }
                else if (AssignModalState == "confirm")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>@AssignModalText</p>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CloseAssignModal">Cancel</button>
                            <button class="btn btn-success px-4" @onclick="ConfirmAssignStudent">Confirm</button>
                        </div>
                    </div>
                }
                else if (AssignModalState == "done")
                {
                    <div class="text-center">
                        <i class="bi bi-person-plus fs-1 text-success"></i>
                        <p class="fw-bold">Tambahkan Siswa</p>
                        <p>Siswa berhasil ditambahkan ke kelas!</p>
                        <button class="btn btn-primary px-4" @onclick="CloseAssignModal">Done</button>
                    </div>
                }
            </Modal>
        }

        @if (ShowDeleteModal)
        {
            <Modal IsVisible="true">
                <div class="modal-scrollable-content">
                    @if (DeleteModalState == "confirm")
                    {
                        <div class="text-center">
                            <i class="bi bi-trash fs-1 mb-3 text-danger"></i>
                            <p class="fw-bold">Hapus Kelas</p>
                            <p>@DeleteModalText</p>
                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <button class="btn btn-warning px-4" @onclick="CloseDeleteModal">Cancel</button>
                                <button class="btn btn-danger px-4" @onclick="ConfirmDeleteClass">Confirm</button>
                            </div>
                        </div>
                    }
                    else if (DeleteModalState == "done")
                    {
                        <div class="text-center">
                            <i class="bi bi-trash fs-1 mb-3 text-danger"></i>
                            <p class="fw-bold">Hapus Kelas</p>
                            <p>@DeleteModalText</p>
                            <button class="btn btn-primary px-4" @onclick="CloseDeleteModal">Done</button>
                        </div>
                    }
                </div>
            </Modal>
        }
    </div>
</div>

@code {
    private bool IsLoading = true;
    private bool ShowAddModal = false;
    private List<ClassItem> Classes = new();
    private List<WalasItem> WalasList = new();
    private NewClass NewClass = new()
    {
        name = string.Empty,
        total_students = 0,
        WaliKelasid = 0,
        year = DateTime.Now.Year,
        description = string.Empty
    };
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private string? SearchText;
    private int? SelectedWalasId;

    private bool ShowAssignModal = false;
    private string AssignModalState = ""; // "empty", "confirm", "done"
    private string AssignModalText = "";
    private int? SelectedClassIdForAssign;

    private CancellationTokenSource? searchDebounceCts;
    private List<string> VisibleTabs = new() { "Manajemen Kelas" };
    private string CurrentTab = "Manajemen Kelas";

    private int? SelectedStudentId;
    private string? SelectedStudentStatus;

    private bool ShowDeleteModal = false;
    private string DeleteModalState = ""; // "confirm", "done"
    private string DeleteModalText = "";
    private int? SelectedClassIdForDelete;
    private string? SelectedClassNameForDelete;

    private bool IsAddClassValid =>
        !string.IsNullOrWhiteSpace(NewClass.name)
        && NewClass.total_students > 0
        && SelectedWalasId.HasValue
        && NewClass.year > 0
        && !string.IsNullOrWhiteSpace(NewClass.description);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
        }

        // Ambil token dari localStorage
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (int.TryParse(query.Get("studentId"), out var sid))
            SelectedStudentId = sid;
        SelectedStudentStatus = query.Get("isPKL");

        await LoadWalas();
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        string url = APIUrl.Endpoint($"classes?page={CurrentPage}");
        if (!string.IsNullOrWhiteSpace(SearchText))
            url += $"&name={SearchText}";

        var response = await Http.GetFromJsonAsync<ClassListResponse>(url);
        if (response != null)
        {
            Classes = response?.classrooms ?? new();
            TotalPages = response?.totalPages ?? 1;
        }
        IsLoading = false;
        StateHasChanged();
    }

    private async Task LoadWalas()
    {
        WalasList = await Http.GetFromJsonAsync<List<WalasItem>>(APIUrl.Endpoint("data/walas"));
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        _ = LoadData();
    }

    private void ChangeTab(string tab)
    {
        CurrentTab = tab;
        CurrentPage = 1;
        SearchText = string.Empty;
    }

    private async void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        searchDebounceCts?.Cancel();
        searchDebounceCts = new CancellationTokenSource();
        var token = searchDebounceCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                CurrentPage = 1;
                await LoadData();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async void ConfirmAdd()
    {
        if (SelectedWalasId.HasValue)
        {
            NewClass.WaliKelasid = SelectedWalasId.Value;
            var res = await Http.PostAsJsonAsync(APIUrl.Endpoint("classes"), NewClass);
            if (res.IsSuccessStatusCode)
            {
                ShowAddModal = false;
                NewClass = new()
                {
                    name = string.Empty,
                    total_students = 0,
                    WaliKelasid = 0,
                    year = DateTime.Now.Year,
                    description = string.Empty
                };
                await LoadData();
            }
        }
    }

    private void CancelAdd()
    {
        NewClass = new()
        {
            name = string.Empty,
            total_students = 0,
            WaliKelasid = 0,
            year = DateTime.Now.Year,
            description = string.Empty
        };
        SelectedWalasId = null;
        ShowAddModal = false;
    }

    void OnAssignStudent(int classId, string className)
    {
        SelectedClassIdForAssign = classId;

        if (SelectedStudentId == null || string.IsNullOrEmpty(SelectedStudentStatus))
        {
            // Pop up kiri: tidak ada data siswa
            AssignModalState = "empty";
            AssignModalText = "Silakan pilih minimal satu siswa terlebih dahulu sebelum melanjutkan.";
        }
        else
        {
            // Pop up tengah: konfirmasi
            AssignModalState = "confirm";
            AssignModalText = $"Apakah Anda yakin ingin menambahkan Siswa ini ke Kelas {className}?";
        }
        ShowAssignModal = true;
    }

    async Task ConfirmAssignStudent()
    {
        if (AssignModalState == "confirm" && SelectedStudentId.HasValue && SelectedClassIdForAssign.HasValue)
        {
            var payload = new { isPKL = SelectedStudentStatus == "True", idClass = SelectedClassIdForAssign.Value };
            var response = await Http.PutAsJsonAsync(APIUrl.Endpoint($"assign/{SelectedStudentId}"), payload);

            if (response.IsSuccessStatusCode)
            {
                // Pop up kanan: sukses
                AssignModalState = "done";
                AssignModalText = $"Siswa berhasil ditambahkan ke kelas!";
            }
        }
    }
    
    void CloseAssignModal()
    {
        ShowAssignModal = false;

        if (AssignModalState == "done")
        {
            SelectedStudentId = null;
            SelectedStudentStatus = null;
            SelectedClassIdForAssign = null;
            AssignModalState = "";
            AssignModalText = "";
            // Navigate to the same page without query parameters
            Navigation.NavigateTo("/participant/class-management", forceLoad: true);
        }
    }

    void OnDeleteClass(int classId, string className)
    {
        SelectedClassIdForDelete = classId;
        SelectedClassNameForDelete = className;
        DeleteModalState = "confirm";
        DeleteModalText = $"Apakah Anda yakin ingin menghapus kelas {className}?";
        ShowDeleteModal = true;
    }

    async Task ConfirmDeleteClass()
    {
        if (DeleteModalState == "confirm" && SelectedClassIdForDelete.HasValue)
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, APIUrl.Endpoint($"classes/{SelectedClassIdForDelete}"));
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                DeleteModalState = "done";
                DeleteModalText = $"Kelas {SelectedClassNameForDelete} berhasil di hapus dari Manajemen Kelas!";
                await LoadData();
            }
        }
    }
    
    void CloseDeleteModal()
    {
        ShowDeleteModal = false;
        SelectedClassIdForDelete = null;
        SelectedClassNameForDelete = null;
        DeleteModalState = "";
        DeleteModalText = "";
    }

    private void GoBack() => Navigation.NavigateTo("/participant");
}
