@attribute [Authorize]
@page "/participant/history"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HistoryState HistoryState
@inject IJSRuntime JS
@inject AlertService AlertService

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model
@using System.Text.Json

<div class="class-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">History</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    @if (ShowWarningModal)
    {
        <Modal IsVisible="true">
            <div class="d-flex flex-column align-items-center p-3">
                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3 mb-2">Peringatan!</h5>
                <div class="mb-4 text-center">
                    Tidak ada siswa yang dipilih untuk ditampilkan datanya.
                </div>
                <button class="btn btn-danger w-100" @onclick="CloseWarningModal">Close</button>
            </div>
        </Modal>
    }

    <div class="content-section">
        @if (StudentDetail != null)
        {
            <div class="student-detail-card mb-4">
                <div class="student-detail-header">Student Detail</div>
                <div class="student-detail-body">
                    <div class="student-detail-col student-detail-col-left">
                        <div class="student-detail-row">
                            <label class="student-detail-label">Nama</label>
                            <input class="student-detail-input" value="@StudentDetail.fullname" readonly />
                        </div>
                        <div class="student-detail-row">
                            <label class="student-detail-label">Kelas</label>
                            <input class="student-detail-input" value="@StudentDetail.class_name" readonly />
                        </div>
                    </div>
                    <div class="student-detail-col student-detail-col-right">
                        <div class="student-detail-row">
                            <label class="student-detail-label">Mentor</label>
                            <input class="student-detail-input" value="@StudentDetail.mentor_name" readonly />
                        </div>
                        <div class="student-detail-row">
                            <label class="student-detail-label">Perusahaan</label>
                            <input class="student-detail-input" value="@StudentDetail.company_name" readonly />
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="section-title mb-3">Presence History</div>
        <div class="scrollable-x mb-4">
            <table class="table table-bordered presence-table">
                <thead class="text-center">
                    <tr>
                        <th>No</th>
                        <th>Hari/Tanggal</th>
                        <th>Jam</th>
                        <th>Status</th>
                        <th>Report</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PresenceHistory?.data?.Count > 0)
                    {
                        var rowIndex = (PresencePage - 1) * PresenceHistory.data.Count;
                        @foreach (var item in PresenceHistory.data)
                        {
                            rowIndex++;
                            <tr>
                                <td class="text-center">@rowIndex</td>
                                <td>@item.date</td>
                                <td>@item.time</td>
                                <td>@item.presence_type</td>
                                <td class="@(item.report == "Report Lengkap" ? "text-success" : (item.report == "Report tidak lengkap" ? "text-danger" : ""))">@item.report</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-info"
                                            @onclick="() => ShowDetail(MapToPresenceItem(item))"
                                            disabled="@(string.IsNullOrWhiteSpace(item.presence_type) || item.presence_type == "-")">
                                        <i class="bi bi-eye me-1"></i> Preview
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Tidak ada data presensi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
            <ul class="pagination d-flex flex-wrap justify-content-center">
                <li class="page-item @(PresencePage == 1 ? "disabled" : null)">
                    <button class="page-link btn-text" @onclick="() => ChangePresencePage(PresencePage - 1)">Previous</button>
                    <button class="page-link btn-icon" @onclick="() => ChangePresencePage(PresencePage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </li>

                <li class="page-item @(PresencePage == 1 ? "active" : null)">
                    <button class="page-link" @onclick="() => ChangePresencePage(1)" disabled="@(PresencePage == 1)">1</button>
                </li>

                @if (PresencePage <= 3)
                {
                    // Tampilkan halaman 2 sampai 4
                    for (int i = 2; i <= Math.Min(4, TotalPagesPresence - 1); i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == PresencePage ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePresencePage(pageNumber)" disabled="@(pageNumber == PresencePage)">@pageNumber</button>
                        </li>
                    }

                    if (TotalPagesPresence > 5)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                else if (PresencePage >= TotalPagesPresence - 2)
                {
                    if (TotalPagesPresence > 5)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    for (int i = TotalPagesPresence - 3; i < TotalPagesPresence; i++)
                    {
                        if (i > 1)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == PresencePage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePresencePage(pageNumber)" disabled="@(pageNumber == PresencePage)">@pageNumber</button>
                            </li>
                        }
                    }
                }

                else
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>

                    for (int i = PresencePage - 1; i <= PresencePage + 1; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == PresencePage ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePresencePage(pageNumber)" disabled="@(pageNumber == PresencePage)">@pageNumber</button>
                        </li>
                    }

                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @if (TotalPagesPresence > 1)
                {
                    <li class="page-item @(PresencePage == TotalPagesPresence ? "active" : null)">
                        <button class="page-link" @onclick="() => ChangePresencePage(TotalPagesPresence)" disabled="@(PresencePage == TotalPagesPresence)">@TotalPagesPresence</button>
                    </li>
                }

                <li class="page-item @(PresencePage == TotalPagesPresence ? "disabled" : null)">
                    <button class="page-link btn-text" @onclick="() => ChangePresencePage(PresencePage + 1)">Next</button>
                    <button class="page-link btn-icon" @onclick="() => ChangePresencePage(PresencePage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </nav>

        <div class="section-title mb-3">Report History</div>
        <div class="scrollable-x mb-4">
            <table class="table table-bordered report-table">
                <thead class="text-center">
                    <tr>
                        <th rowspan="2">No</th>
                        <th rowspan="2">Hari/Tanggal</th>
                        <th rowspan="2">Jam</th>
                        <th rowspan="2">Deskripsi</th>
                        <th colspan="3">Feedback</th>
                        <th rowspan="2">Action</th>
                    </tr>
                    <tr>
                        <th>Mentor</th>
                        <th>Walas</th>
                        <th>Kajur</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ReportHistory?.data?.Count > 0)
                    {
                        var rowIndex = (ReportPage - 1) * ReportHistory.data.Count;
                        @foreach (var item in ReportHistory.data)
                        {
                            rowIndex++;
                            <tr>
                                <td class ="text-center">@rowIndex</td>
                                <td>@item.date</td>
                                <td>@item.time</td>
                                <td>@item.description</td>
                                <td>@item.feedback?.mentor</td>
                                <td>@item.feedback?.walas</td>
                                <td>@item.feedback?.kajur</td>
                                <td>
                                    <div class="d-flex flex-column gap-2 align-items-center">
                                        <button class="btn btn-sm btn-success" style="padding-left: 0.9rem; padding-right: 0.9rem;"
                                                @onclick='() => ShowReportDetail(item, "photo")'>
                                            <i class="bi bi-image me-1"></i> Photo
                                        </button>
                                        <button class="btn btn-sm btn-warning"
                                                @onclick='() => ShowReportDetail(item, "file")'>
                                            <i class="bi bi-file-earmark-text me-1"></i> Laporan
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">Tidak ada data laporan.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
            <ul class="pagination d-flex flex-wrap justify-content-center">
                <li class="page-item @(ReportPage == 1 ? "disabled" : null)">
                    <button class="page-link btn-text" @onclick="() => ChangeReportPage(ReportPage - 1)">Previous</button>
                    <button class="page-link btn-icon" @onclick="() => ChangeReportPage(ReportPage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </li>

                <li class="page-item @(ReportPage == 1 ? "active" : null)">
                    <button class="page-link" @onclick="() => ChangeReportPage(1)" disabled="@(ReportPage == 1)">1</button>
                </li>

                @if (ReportPage <= 3)
                {
                    // Tampilkan halaman 2 sampai 4
                    for (int i = 2; i <= Math.Min(4, TotalPagesReport - 1); i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == ReportPage ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangeReportPage(pageNumber)" disabled="@(pageNumber == ReportPage)">@pageNumber</button>
                        </li>
                    }

                    if (TotalPagesReport > 5)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                else if (ReportPage >= TotalPagesReport - 2)
                {
                    if (TotalPagesReport > 5)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    for (int i = TotalPagesReport - 3; i < TotalPagesReport; i++)
                    {
                        if (i > 1)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == ReportPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangeReportPage(pageNumber)" disabled="@(pageNumber == ReportPage)">@pageNumber</button>
                            </li>
                        }
                    }
                }

                else
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>

                    for (int i = ReportPage - 1; i <= ReportPage + 1; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == ReportPage ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangeReportPage(pageNumber)" disabled="@(pageNumber == ReportPage)">@pageNumber</button>
                        </li>
                    }

                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @if (TotalPagesReport > 1)
                {
                    <li class="page-item @(ReportPage == TotalPagesReport ? "active" : null)">
                        <button class="page-link" @onclick="() => ChangeReportPage(TotalPagesReport)" disabled="@(ReportPage == TotalPagesReport)">@TotalPagesReport</button>
                    </li>
                }

                <li class="page-item @(ReportPage == TotalPagesReport ? "disabled" : null)">
                    <button class="page-link btn-text" @onclick="() => ChangeReportPage(ReportPage + 1)">Next</button>
                    <button class="page-link btn-icon" @onclick="() => ChangeReportPage(ReportPage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </nav>

        @if (ShowDetailModal && SelectedPresenceDetail != null)
        {
            <Modal IsVisible="true">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <button class="btn btn-link"
                            @onclick="ShowPrevPresence"
                            disabled="@(SelectedPresenceIndex <= 0)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="fw-bold" style="flex:1;text-align:center; font-size:20px">Presence Detail</span>
                    <button class="btn btn-link"
                            @onclick="ShowNextPresence"
                            disabled="@(SelectedPresenceIndex >= Presences?.Where(p => !string.IsNullOrWhiteSpace(p.presence_type) && p.presence_type != "-").Count() - 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <div class="mb-2" style="max-height:400px;overflow-y:auto;">
                    @if (PreviewPresenceFields != null && PreviewPresenceFields.Count > 0)
                    {
                        @if (PreviewPresenceTypeId == 5)
                        {
                            <div class="mb-3">
                                <!-- Foto Full Body -->
                                <div class="mx-1">
                                    <label class="d-block mt-2 mb-1 fw-normal">Foto Full Body</label>
                                    <label class="upload-box-report">
                                        @if (PreviewPresencePhotoUrls.ContainsKey("FullBodyPhoto") && PreviewPresencePhotoUrls["FullBodyPhoto"] != null)
                                        {
                                            <img src="@PreviewPresencePhotoUrls["FullBodyPhoto"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Info WFH dari Perusahaan -->
                                <div class="mx-1">
                                    <label class="d-block mt-2 mb-1 fw-normal">Info WFH dari Perusahaan</label>
                                    <label class="upload-box-report">
                                        @if (PreviewPresencePhotoUrls.ContainsKey("WFHFromCompany") && PreviewPresencePhotoUrls["WFHFromCompany"] != null)
                                        {
                                            <img src="@PreviewPresencePhotoUrls["WFHFromCompany"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Location -->
                                <div class="mx-1">
                                    <div class="mt-3 mb-1">Location</div>
                                    <div class="presence-modal-value">
                                        <div id="detailPresenceMap" class="detail-presence-map"></div>
                                        <div class="mt-2 text-muted" style="font-size:small;">
                                            * Klik Peta untuk preview pada Google Maps
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                @foreach (var field in PreviewPresenceFields)
                                {
                                    <div class="mx-1">
                                        <label class="d-block mt-2 mb-1 fw-normal">@field.Label</label>
                                        <label class="upload-box-report">
                                            @if (PreviewPresencePhotoUrls.ContainsKey(field.Field) && PreviewPresencePhotoUrls[field.Field] != null)
                                            {
                                                <img src="@PreviewPresencePhotoUrls[field.Field]" class="img-upload-preview" />
                                            }
                                            else
                                            {
                                                <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                        @if ((field.Field == "FullBodyPhoto") && !string.IsNullOrWhiteSpace(PreviewPresenceReport))
                                        {
                                            <div class="mt-3 mb-1">Location</div>
                                            <div class="presence-modal-value">
                                                <div id="detailPresenceMap" class="detail-presence-map"></div>
                                                <div class="mt-2 text-muted" style="font-size:small;">
                                                    * Klik Peta untuk preview pada Google Maps
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <button class="btn btn-primary w-100 " @onclick="CloseDetailModal">Close</button>
            </Modal>
        }
    </div>
</div>
