@attribute [Authorize]
@page "/home/profile/me"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AlertService AlertService

@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model

<div class="myprofile-wrapper">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">My Profile</h5>
    </div>

    <div class="content-section d-flex flex-column align-items-center">
        <div class="card w-100 shadow-sm d-flex flex-column align-items-center p-4">
            <div class="profile-photo-container position-relative mb-3">
                <img src="@profilePhotoPreview" class="profile-photo" @onclick="TriggerPhotoInput" />
                <InputFile id="profilePhotoInput" class="d-none" OnChange="OnPhotoChanged" accept="image/*" />
                <span class="profile-photo-edit-icon position-absolute">
                    <i class="bi bi-camera"></i>
                </span>
            </div>

            <div class="mb-3 w-100" style="max-width:450px;">
                <label class="form-label fw-bold">@IdLabel - Nama Lengkap</label>
                <input class="form-control"
                       placeholder="@($"{IdPlaceholder} - Nama Lengkap")"
                       @bind="nisnipFullname"
                       @oninput="OnNisNipFullnameChanged" />
                @if (showNisNipFullnameError)
                {
                    <div class="text-danger small mt-1">Format harus: @IdLabel - Nama Lengkap</div>
                }
            </div>

            @if (role == "Student")
            {
                <div class="mb-3 w-100" style="max-width:450px;">
                    <label class="form-label fw-bold">Kelas</label>
                    <select class="form-select" @bind="selectedClassId">
                        <option value="">Pilih</option>
                        @foreach (var cls in classList)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>

                <div class="mb-3 w-100" style="max-width:450px;">
                    <label class="form-label fw-bold">Lokasi PKL</label>
                    <select class="form-select" @bind="selectedCompanyLocationId">
                        <option value="">Pilih</option>
                        @foreach (var comp in companyLocationList)
                        {
                            <option value="@comp.id">@comp.LocationName</option>
                        }
                    </select>
                </div>
            }

            <div class="mb-4 w-100" style="max-width:450px;">
                <label class="form-label fw-bold">Email</label>
                <input class="form-control"
                       placeholder="contoh: email@domain.com"
                       @bind="email"
                       @oninput="ValidateEmail" />
                @if (!string.IsNullOrEmpty(emailError))
                {
                    <div class="text-danger small mt-1">@emailError</div>
                }
            </div>

            <div class="mb-4 w-100 d-flex justify-content-center gap-2" style="max-width:450px;">
                <button type="button"
                        class="btn @(gender == true ? "btn-primary" : "btn-light gender-unselected") w-50"
                        @onclick="() => SetGender(true)">
                    <i class="bi bi-gender-male"></i>
                    <span class="btn-text-sm-hide ms-1">Male</span>
                </button>
                <button type="button"
                        class="btn @(gender == false ? "btn-primary" : "btn-light gender-unselected") w-50"
                        @onclick="() => SetGender(false)">
                    <i class="bi bi-gender-female"></i>
                    <span class="btn-text-sm-hide ms-1">Female</span>
                </button>
            </div>

            <button class="btn btn-success w-100"
                    style="max-width:450px;"
                    @onclick="SaveProfile"
                    disabled="@(!IsFormValid)">
                <i class="bi bi-save"></i>
                <span class="btn-text-sm-hide ms-1">Save</span>
            </button>
        </div>
    </div>
</div>