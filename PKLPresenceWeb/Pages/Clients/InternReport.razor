    async Task ConfirmReport()
    {
        if (string.IsNullOrWhiteSpace(ContentInput))
        {
            CloseDetailModal();
            return;
        }

        IsSubmittingReport = true;

        var formData = new MultipartFormDataContent();

        // Deskripsi kegiatan
        formData.Add(new StringContent(ContentInput), "description");

        // Foto bimbingan dari WebRTC
        if (WebRTCPhotoDataUrl != null)
        {
            // Ambil base64 dari dataUrl
            var base64 = WebRTCPhotoDataUrl.Substring(WebRTCPhotoDataUrl.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64);

            // Tentukan mimeType dan ekstensi
            var mimeType = WebRTCPhotoDataUrl.Substring(5, WebRTCPhotoDataUrl.IndexOf(";") - 5);
            var ext = mimeType switch
            {
                "image/png" => ".png",
                "image/jpeg" => ".jpg",
                "image/jpg" => ".jpg",
                _ => ".jpg"
            };

            var fileContent = new ByteArrayContent(bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mimeType);
            formData.Add(fileContent, "guidancePhoto", $"guidance{ext}");
        }

        // File laporan (upload)
        if (UploadedReportFile != null)
        {
            var stream = UploadedReportFile.OpenReadStream(10 * 1024 * 1024); // max 10MB
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(UploadedReportFile.ContentType);
            formData.Add(fileContent, "reportFile", UploadedReportFile.Name);
        }

        var response = await Http.PostAsync(APIUrl.Endpoint("repots"), formData);
        IsSubmittingReport = false;

        if (response.IsSuccessStatusCode)
        {
            CloseDetailModal();
            await LoadReports();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Gagal submit report.");
        }
    }

    async Task OnFeedbackButtonClick()
    {
        if (string.IsNullOrWhiteSpace(FeedbackInput))
        {
            CloseDetailModal();
            return;
        }

        if (SelectedReportDetail == null)
            return;

        IsSubmittingFeedback = true;
        var feedbackObj = new { feedback = FeedbackInput };
        var content = new StringContent(
            System.Text.Json.JsonSerializer.Serialize(feedbackObj),
            System.Text.Encoding.UTF8,
            "application/json"
        );
        var response = await Http.PutAsync(APIUrl.Endpoint($"repots/feedback/{SelectedReportDetail.id}"), content);
        IsSubmittingFeedback = false;

        if (response.IsSuccessStatusCode)
        {
            CloseDetailModal();
            await LoadReports();
        }
        else await JS.InvokeVoidAsync("alert", "Gagal submit feedback.");
    }

