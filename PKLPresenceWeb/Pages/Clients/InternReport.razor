@attribute [Authorize]
@page "/report"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using PKLPresenceWeb.Model
@using System.Text.Json

<div class="report-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Intern Report</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        @if (UserRole == "Student")
        {
            <div class="d-flex justify-content-end gap-2 mb-3 presence-radio-group">
                <button class="btn btn-warning"
                        @onclick="ShowAddReport"
                        disabled="@HasReportToday">
                    <i class="bi bi-plus-lg me-1"></i> Add Report
                </button>
            </div>

            <div class="scrollable-x">
                <table class="table table-bordered student-table">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            <th class="text-center">Hari/Tanggal</th>
                            <th class="text-center">Jam</th>
                            <th class="text-center">Deskripsi</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Reports is not null && Reports.Count > 0)
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize;
                            @foreach (var item in Reports)
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    <td>@item.date</td>
                                    <td>@item.time</td>
                                    <td>@item.description</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-success" style="padding-left: 1.15rem; padding-right: 1.15rem;"
                                                @onclick="() => ShowReportDetail(item)">
                                            <i class="bi bi-info-circle me-1"></i> Detail
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">Tidak ada data laporan PKL.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <select class="form-select page-size-dropdown mt-3 mb-3" @bind="PageSize">
                <option value="5">Show 5 Entries</option>
                <option value="10">Show 10 Entries</option>
                <option value="15">Show 15 Entries</option>
            </select>

            <nav class="d-flex justify-content-center mt-2">
                <ul class="pagination">
                    @if (Reports is null || Reports.Count == 0)
                    {
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                        </li>
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                <button class="page-link"
                                        @onclick="() => ChangePage(pageNum)"
                                        disabled="@(pageNum == CurrentPage)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    }
                </ul>
            </nav>

            @if (ShowReportModal)
            {
                <Modal IsVisible="true" Title="Submit Report">
                    <div class="mb-2">
                        <label class="my-2">Foto Saat Bimbingan</label>
                        <div style="display: flex; justify-content: center;">
                            <div class="custom-upload-box @(WebRTCPhotoDataUrl == null ? "no-photo" : "has-photo")" @onclick="OpenWebRTCModal">
                                @if (WebRTCPhotoDataUrl != null)
                                {
                                    <img src="@WebRTCPhotoDataUrl" class="uploaded-photo-preview" />
                                }
                                else
                                {
                                    <span class="text-muted d-flex flex-column align-items-center justify-content-center">
                                        <i class="bi bi-image" style="font-size:2rem;"></i>
                                        <br />Upload Foto
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label>Deskripsi Kegiatan</label>
                        <textarea id="ContentInput"
                                  class="form-control mt-2"
                                  placeholder="Deskripsi..."
                                  @bind="ContentInput"
                                  @oninput="OnContentInput"
                                  maxlength="200"
                                  rows="3"></textarea>
                        <div class="char-counter-outer">@ContentInput.Length/200</div>
                    </div>
                    <div class="mb-3 text-center">
                        <label class="mb-2">File Laporan</label>
                        <div class="file-upload-center">
                            <InputFile OnChange="OnReportFileSelected" accept=".pdf"
                                    style="max-width: 300px; width: 90%;" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-around mt-2">
                        <button class="btn btn-danger px-4" @onclick="CancelReport">Cancel</button>
                        <button class="btn btn-success px-4"
                                @onclick="ConfirmReport"
                                disabled="@( !IsReportFormValid )">
                            Confirm
                        </button>
                    </div>
                </Modal>
            }

            @if (ShowWebRTCModal)
            {
                <Modal IsVisible="true">
                    <div class="modal-header position-relative">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2"
                                aria-label="Close" @onclick="CloseWebRTCModal">
                        </button>

                        <h5 class="modal-title fw-bold w-100 text-center">Ambil Foto</h5>
                    </div>

                    <div class="position-relative d-flex flex-column align-items-center mt-3">
                        <video id="webrtc_capture" autoplay playsinline class="webrtc-modal-videos"></video>
                        @if (IsWebRTCCaptureCounting && WebRTCCaptureCountdown > 0)
                        {
                            <div class="webrtc-countdown-anim">
                                @WebRTCCaptureCountdown
                            </div>
                        }

                        <!-- Tombol kontrol -->
                        <div class="d-flex gap-3 mt-3 align-items-center">

                            <!-- Timer dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-warning" type="button" id="timerMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clock"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownTimerBtn">
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(0))">None</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(3))">3s</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(5))">5s</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(7))">7s</a></li>
                                </ul>
                            </div>

                            <!-- Capture -->
                            <button class="btn-circle-capture" title="Capture" @onclick="CaptureWebRTCPhoto">
                                <i class="bi bi-camera" style="font-size:1.2rem; color: black"></i>
                            </button>

                            @* <!-- Switch Camera -->
                            <button class="btn btn-outline-secondary px-3" title="Switch Camera" @onclick="SwitchCamera">
                                <i class="bi bi-arrow-repeat"></i>
                            </button> *@
                        </div>
                    </div>
                </Modal>
            }
        }
        else
        {
            <div class="row g-2 mb-3 align-items-end">
                <div class="col">
                    <input class="form-control" placeholder="Search..." @bind="searchName" @oninput="OnFilterChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in ClassList)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="date-group-responsive d-flex align-items-center gap-1">
                        <button class="chevron-date-btn"
                                @onclick="PrevDate">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <input type="date"
                               class="form-control"
                               style="min-width: 120px;"
                               value="@selectedDate"
                               min="@MinDate"
                               max="@MaxDate"
                               @onchange="OnDateSelected" />
                        <button class="chevron-date-btn"
                                @onclick="NextDate"
                                disabled="@IsTodaySelected">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center mb-3 report-toolbar">
                @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                {
                    <div class="d-flex gap-2 btn-group-toolbar">
                        <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="PrintPerMentor">
                            <span class="d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-printer"></i>
                                <span class="d-none d-sm-inline">Per Mentor</span>
                                <span class="d-inline d-sm-none">Mentor</span>
                            </span>
                        </button>
                        <button class="btn btn-primary flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="PrintPerClass">
                            <span class="d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-printer"></i>
                                <span class="d-none d-sm-inline">Per Class</span>
                                <span class="d-inline d-sm-none">Class</span>
                            </span>
                        </button>
                    </div>
                }
                else
                {
                    <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="Print">
                        <span class="d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-printer"></i> Print
                        </span>
                    </button>
                }
            </div>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="scrollable-x">
                    <table class="table table-bordered @(UserRole == "Teacher" ? "admin-table" : "mentor-table")">
                        <thead>
                            <tr>
                                <th class="text-center">No</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.nis))">
                                    NIS
                                    @if (SortColumn == nameof(ReportItem.nis))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.name))">
                                    Nama Lengkap
                                    @if (SortColumn == nameof(ReportItem.name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.classroom_name))">
                                    Kelas
                                    @if (SortColumn == nameof(ReportItem.classroom_name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.company_name))">
                                    Nama PT
                                    @if (SortColumn == nameof(ReportItem.company_name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center">Hari/Tanggal</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.time))">
                                    Jam
                                    @if (SortColumn == nameof(ReportItem.time))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.description))">
                                    Deskripsi
                                    @if (SortColumn == nameof(ReportItem.description))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick='() => SortBy("Bimbingan")'>
                                    Bimbingan
                                    @if (SortColumn == "Bimbingan")
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                @if (UserRole != "Teacher" && UserRole != "Student")
                                {
                                    <th class="text-center">Action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Reports is not null && Reports.Count > 0)
                            {
                                var sortedPresences = PageSize == 1000
                                ? GetSortedReports()
                                : GetSortedReports().Skip((CurrentPage - 1) * PageSize).Take(PageSize);
                                var rowIndex = PageSize == 1000 ? 0 : (CurrentPage - 1) * PageSize;
                                foreach (var item in sortedPresences)
                                {
                                    rowIndex++;
                                    <tr>
                                        <td class="text-center">@rowIndex</td>
                                        <td>@item.nis</td>
                                        <td>@item.name</td>
                                        <td>@item.classroom_name</td>
                                        <td>@item.company_name</td>
                                        <td>@item.date</td>
                                        <td>@item.time</td>
                                        <td>@item.description</td>
                                        <td class="text-center">
                                            @if (item.isGuidance == "✔️")
                                            {
                                                <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                            else
                                            {
                                                <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                        </td>
                                        @if (UserRole != "Teacher" && UserRole != "Student")
                                        {
                                            <td>
                                                <div class="d-flex flex-column gap-2 align-items-center">
                                                    <button class="btn btn-sm btn-success" style="padding-left: 1.2rem; padding-right: 1.2rem;"
                                                            @onclick="() => ShowReportDetail(item)"
                                                            disabled="@(item.id == "-")">
                                                        <i class="bi bi-info-circle"></i>
                                                        <span class="btn-text-sm-hide ms-1">Detail</span>
                                                    </button>
                                                    <button class="btn btn-sm btn-warning" @onclick="() => ShowFeedback(item)" disabled="@(item.id == "-")">
                                                        <i class="bi bi-chat-dots"></i>
                                                        <span class="btn-text-sm-hide ms-1">Feedback</span>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" 
                                                            @onclick="() => PrintStudentReport(item)" 
                                                            style="padding-left: 1.4rem; padding-right: 1.4rem;" 
                                                            disabled="@(item.id == "-")">
                                                        <i class="bi bi-printer"></i>
                                                        <span class="btn-text-sm-hide ms-1">Print</span>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-muted">Tidak ada data report.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <select class="form-select page-size-dropdown my-3" style="max-width:170px;" @bind="PageSize">
                    <option value="10">Show 10 Entries</option>
                    <option value="50">Show 50 Entries</option>
                    <option value="100">Show 100 Entries</option>
                    <option value="1000">Show All Entries</option>
                </select>

                <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                    <ul class="pagination d-flex flex-wrap justify-content-center">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>

                        <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                        </li>

                        @if (CurrentPage <= 3)
                        {
                            for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        else if (CurrentPage >= TotalPages - 2)
                        {
                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            for (int i = TotalPages - 3; i < TotalPages; i++)
                            {
                                if (i > 1)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                    </li>
                                }
                            }
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>

                            for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @if (TotalPages > 1)
                        {
                            <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                            </li>
                        }

                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            }
        }

        @if ((ShowReportDetailModal || ShowFeedbackModal) && SelectedReportDetail != null)
        {
            <Modal IsVisible="true">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    @if (UserRole != "Student")
                    {
                        <button class="btn btn-link" @onclick="ShowPrevReport" disabled="@IsPrevReportDisabled">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    }
                    <span class="fw-bold" style="flex:1;text-align:center; font-size:20px">
                        @(ShowFeedbackModal ? "Give Feedback" : "Report Detail")
                    </span>
                    @if (UserRole != "Student")
                    {
                        <button class="btn btn-link" @onclick="ShowNextReport" disabled="@IsNextReportDisabled">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
                <div class="mb-2" style="max-height:400px;overflow-y:auto;">
                    <div class="report-modal-grid mb-3 mt-3 text-start">
                        <div class="report-modal-label">NIS</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.nis</div>

                        <div class="report-modal-label">Nama Lengkap</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.name</div>

                        <div class="report-modal-label">Kelas</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.classroom_name</div>

                        <div class="report-modal-label">Hari/Tanggal</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.date</div>

                        <div class="report-modal-label">Jam</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.time WIB</div>

                        <div class="report-modal-label">Nama PT</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.company_name</div>
                    </div>

                    <h6 class="fw-bold my-3" style="font-size:17px">Feedback</h6>

                    @if (ShowFeedbackModal)
                    {
                        <div class="mb-2 mx-1">
                            <textarea id="feedbackInput"
                                      class="form-control"
                                      placeholder="Masukkan Feedback"
                                      @bind="FeedbackInput"
                                      @oninput="OnFeedbackInput"
                                      maxlength="100"
                                      rows="3"></textarea>
                            <div class="char-counter-outer">@FeedbackInput.Length/100</div>
                        </div>
                    }
                    else
                    {
                        <div class="feedback-grid text-start mb-3">
                            <div class="feedback-label">Kepala Jurusan</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedReportDetail.feedback?.kajur))</div>

                            <div class="feedback-label">Mentor</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedReportDetail.feedback?.mentor))</div>

                            <div class="feedback-label">Wali Kelas</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedReportDetail.feedback?.walas))</div>
                        </div>
                    }

                    @if (!ShowFeedbackModal)
                    {
                        <div class="modal-preview-section mt-3 mb-2">
                            <h6 class="fw-bold mt-3">Description</h6>
                            <div class="my-2">Foto Saat Bimbingan</div>
                            <img src="@APIUrl.Endpoint($"reports/preview/{SelectedReportDetail.reportPhotoId}")"
                                 alt="Foto Saat Bimbingan" class="uploaded-photo-preview" />
                            <div class="mb-2 mt-3">Deskripsi Kegiatan</div>
                            <div class="mb-2 mx-2">
                                <textarea class="form-control" readonly rows="3">@SelectedReportDetail.description</textarea>
                            </div>
                            <div class="mb-2">File Laporan</div>
                            <button class="btn btn-outline-primary btn-sm"
                                    @onclick="() => OpenFileInNewTab(SelectedReportDetail.reportFileId)">
                                Preview
                            </button>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 w-100 mt-2">
                    @if (ShowFeedbackModal)
                    {
                        <button class="btn btn-primary w-100"
                                @onclick="OnFeedbackButtonClick"
