@attribute [Authorize]
@page "/report"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using PKLPresenceWeb.Model

<div class="report-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Intern Report</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        @if (UserRole == "Student")
        {
            <div class="d-flex justify-content-end gap-2 mb-3 presence-radio-group">
                <button class="btn btn-warning"
                        @onclick="ShowAddReport"
                        disabled="@HasReportToday">
                    Add Report
                </button>
            </div>

            <div class="scrollable-x">
                <table class="table table-bordered student-table">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            <th class="text-center">Hari/Tanggal</th>
                            <th class="text-center">Jam</th>
                            <th class="text-center">Ringkasan</th>
                            <th class="text-center">Feedback</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Reports is not null && Reports.Count > 0)
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize;
                            @foreach (var item in Reports)
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    <td>@item.date</td>
                                    <td>@item.time</td>
                                    <td>@item.description</td>
                                    <td>@item.feedback</td>
                                    <td>
                                        <button class="btn btn-sm btn-info" style="padding-left: 1.15rem; padding-right: 1.15rem;"
                                                @onclick="() => ShowReportDetail(item)">
                                            Detail
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">Tidak ada data laporan PKL.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <select class="form-select page-size-dropdown mt-3 mb-3" @bind="PageSize">
                <option value="5">Show 5 Entries</option>
                <option value="10">Show 10 Entries</option>
                <option value="15">Show 15 Entries</option>
            </select>

            <nav class="d-flex justify-content-center mt-2">
                <ul class="pagination">
                    @if (Reports is null || Reports.Count == 0)
                    {
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                        </li>
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                <button class="page-link"
                                        @onclick="() => ChangePage(pageNum)"
                                        disabled="@(pageNum == CurrentPage)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        </li>
                    }
                </ul>
            </nav>

            @if (ShowReportModal)
            {
                <Modal IsVisible="true" Title="Submit Report">
                    <div class="mb-2">
                        <label class="my-2">Foto Saat Bimbingan</label>
                        <div style="display: flex; justify-content: center;">
                            <div class="custom-upload-box @(WebRTCPhotoDataUrl == null ? "no-photo" : "has-photo")" @onclick="OpenWebRTCModal">
                                @if (WebRTCPhotoDataUrl != null)
                                {
                                    <img src="@WebRTCPhotoDataUrl" class="uploaded-photo-preview" />
                                }
                                else
                                {
                                    <span class="text-muted d-flex flex-column align-items-center justify-content-center">
                                        <i class="bi bi-image" style="font-size:2rem;"></i>
                                        <br />Upload Foto
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label>Deskripsi Kegiatan</label>
                        <textarea id="ContentInput"
                                  class="form-control mt-2"
                                  placeholder="Deskripsi..."
                                  @bind="ContentInput"
                                  @oninput="OnContentInput"
                                  maxlength="200"
                                  rows="3"></textarea>
                        <div class="char-counter-outer">@ContentInput.Length/200</div>
                    </div>
                    <div class="mb-3 text-center">
                        <label class="mb-2">File Laporan</label>
                        <div class="file-upload-center">
                            <InputFile OnChange="OnReportFileSelected" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                                    style="max-width: 300px; width: 90%;" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-around mt-2">
                        <button class="btn btn-danger px-4" @onclick="CancelReport">Cancel</button>
                        <button class="btn btn-success px-4"
                                @onclick="ConfirmReport"
                                disabled="@( !IsReportFormValid )">
                            Confirm
                        </button>
                    </div>
                </Modal>
            }

            @if (ShowWebRTCModal)
            {
                <Modal IsVisible="true">
                    <div class="modal-header position-relative">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2"
                                aria-label="Close" @onclick="CloseWebRTCModal">
                        </button>

                        <h5 class="modal-title fw-bold w-100 text-center">Ambil Foto</h5>
                    </div>

                    <div class="position-relative d-flex flex-column align-items-center mt-3">
                        <video id="webrtc_capture" autoplay playsinline class="webrtc-modal-videos"></video>
                        @if (IsWebRTCCaptureCounting && WebRTCCaptureCountdown > 0)
                        {
                            <div class="webrtc-countdown-anim">
                                @WebRTCCaptureCountdown
                            </div>
                        }

                        <!-- Tombol kontrol -->
                        <div class="d-flex gap-3 mt-3 align-items-center">

                            <!-- Timer dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-warning" type="button" id="timerMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clock"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownTimerBtn">
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(0))">None</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(3))">3s</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(5))">5s</a></li>
                                </ul>
                            </div>

                            <!-- Capture -->
                            <button class="btn-circle-capture" title="Capture" @onclick="CaptureWebRTCPhoto">
                                <i class="bi bi-camera" style="font-size:1.2rem; color: black"></i>
                            </button>

                            @* <!-- Switch Camera -->
                            <button class="btn btn-outline-secondary px-3" title="Switch Camera" @onclick="SwitchCamera">
                                <i class="bi bi-arrow-repeat"></i>
                            </button> *@
                        </div>
                    </div>
                </Modal>
            }

            @if (ShowReportSuccess)
            {
                <Modal IsVisible="true">
                    <div class="text-center">
                        <span class="checkmark-report-animate">
                            <i class="bi bi-check-circle-fill" style="font-size:3rem; color:limegreen;"></i>
                        </span>
                        <p class="mt-2 fw-bold" style="font-size:20px">Success</p>
                        <p class="mt-1">Report berhasil disubmit!</p>
                    </div>
                </Modal>
            }
        }
        else
        {
            <div class="row g-2 mb-3">
                <div class="col">
                    <input class="form-control" placeholder="Nama Siswa..." @bind="searchName" @oninput="OnFilterChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in ClassList)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <input type="date"
                           class="form-control"
                           style="w-100 w-md-auto"
                           value="@selectedDate"
                           min="@MinDate"
                           max="@MaxDate"
                           @onchange="OnDateSelected" />
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @* <div class="scrollable-x">
