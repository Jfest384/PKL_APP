                        </table>
                    }
                </div> *@

                <div class="scrollable-x">
                    <table class="table table-bordered @(UserRole == "Teacher" ? "admin-table" : "mentor-table")">
                        <thead>
                            <tr>
                                <th class="text-center">No</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.nis))">
                                    NIS
                                    @if (SortColumn == nameof(ReportItem.nis))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.name))">
                                    Nama Lengkap
                                    @if (SortColumn == nameof(ReportItem.name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.classroom_name))">
                                    Kelas
                                    @if (SortColumn == nameof(ReportItem.classroom_name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center">Hari/Tanggal</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.time))">
                                    Jam
                                    @if (SortColumn == nameof(ReportItem.time))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.company_name))">
                                    Nama PT
                                    @if (SortColumn == nameof(ReportItem.company_name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.description))">
                                    Deskripsi
                                    @if (SortColumn == nameof(ReportItem.description))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(ReportItem.feedback))">
                                    Feedback
                                    @if (SortColumn == nameof(ReportItem.feedback))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick='() => SortBy("Bimbingan")'>
                                    Bimbingan
                                    @if (SortColumn == "Bimbingan")
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                @if (UserRole != "Teacher" && UserRole != "Student")
                                {
                                    <th class="text-center">Action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Reports is not null && Reports.Count > 0)
                            {
                                var sortedPresences = PageSize == 1000
                                ? GetSortedReports()
                                : GetSortedReports().Skip((CurrentPage - 1) * PageSize).Take(PageSize);
                                var rowIndex = PageSize == 1000 ? 0 : (CurrentPage - 1) * PageSize;
                                foreach (var item in sortedPresences)
                                {
                                    rowIndex++;
                                    <tr>
                                        <td class="text-center">@rowIndex</td>
                                        <td>@item.nis</td>
                                        <td>@item.name</td>
                                        <td>@item.classroom_name</td>
                                        <td>@item.date</td>
                                        <td>@item.time</td>
                                        <td>@item.company_name</td>
                                        <td>@item.description</td>
                                        <td>@item.feedback</td>
                                        <td class="text-center">
                                            @if (item.isGuidance == "✔️")
                                            {
                                                <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                            else
                                            {
                                                <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                        </td>
                                        @if (UserRole != "Teacher" && UserRole != "Student")
                                        {
                                            <td>
                                                <div class="d-flex flex-column gap-2 align-items-center">
                                                    <button class="btn btn-sm btn-success" @onclick="() => ShowFeedback(item)">Feedback</button>
                                                    @if (UserRole == "Mentor")
                                                    {
                                                        <button class="btn btn-sm btn-warning"
                                                                @onclick="() => ShowGuidance(item.studentId, item.name)"
                                                                disabled="@(item.isGuidance == "✔️")"
                                                                style="font-size: 0.8rem;">
                                                            Bimbingan
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-info" style="padding-left: 1.15rem; padding-right: 1.15rem;"
                                                            @onclick="() => ShowReportDetail(item)">
                                                        Detail
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted">Tidak ada data presensi.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mb-2">
                    <div class="mw-100 mt-3">
                        <select id="rekapDropdown" class="form-select" @bind="selectedDropdown">
                            <option value="" disabled selected hidden>Cetak Rekap</option>
                            <option value="Siswa">Per Siswa</option>
                            <option value="Pembimbing">Per Pembimbing</option>
                            <option value="Kelas">Per Kelas</option>
                        </select>
                    </div>
                </div>

                <select class="form-select page-size-dropdown my-3" style="max-width:170px;" @bind="PageSize">
                    <option value="10">Show 10 Entries</option>
                    <option value="50">Show 50 Entries</option>
                    <option value="100">Show 100 Entries</option>
                    <option value="1000">Show All Entries</option>
                </select>

                <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                    <ul class="pagination d-flex flex-wrap justify-content-center">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        </li>

                        <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                        </li>

                        @if (CurrentPage <= 3)
                        {
                            for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        else if (CurrentPage >= TotalPages - 2)
                        {
                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            for (int i = TotalPages - 3; i < TotalPages; i++)
                            {
                                if (i > 1)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                    </li>
                                }
                            }
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>

                            for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @if (TotalPages > 1)
                        {
                            <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                            </li>
                        }

                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            }
        }

        @if (ShowReportDetailModal && SelectedReportDetail != null)
        {
            <Modal IsVisible="true" Title="Report Detail">
                <div class="modal-scrollable-content">
                    <div class="report-modal-grid mb-3 mt-3 text-start">
                        <div class="report-modal-label">NIS</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.nis</div>

                        <div class="report-modal-label">Nama Lengkap</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.name</div>

                        <div class="report-modal-label">Kelas</div>
                        <div class="report-modal-colon">:</div>
                        <div class="report-modal-value">@SelectedReportDetail.classroom_name</div>

