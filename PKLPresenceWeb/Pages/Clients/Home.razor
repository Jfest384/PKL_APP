@attribute [Authorize]
@page "/home"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Model
@inject AuthenticationStateProvider AuthStateProvider

<div class="home-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="user-info">
            <p class="text-white">Selamat datang,</p>
            <p class="fw-bold text-white" style="font-size: 1.2rem;">@fullName</p>
            <p class="fw-semibold text-white" style="font-size: 0.8rem;">@secondLine</p>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        <div class="card-instruction mb-3">
            <p class="fw-semibold mb-1">
                <i class="bi bi-check-circle me-1" style="color: green"></i> Tatacara Presensi Kehadiran PKL
            </p>
            <ol class="mb-1">
                <li>Masuk ke menu Presence.</li>
                <li>
                    Pilih status kehadiran.
                    <ul>
                        <li>Hadir</li>
                        <li>Sakit</li>
                        <li>Izin</li>
                        <li>Libur</li>
                        <li>WFH</li>
                    </ul>
                </li>
            </ol>
            <span class="text-muted d-block mt-2">
                <p class="mb-0" style="color: red">
                    Note:
                </p>
                <ul>
                    <li>Presensi dilakukan setiap hari, dan hanya dapat dilakukan 1x dalam sehari.</li>
                </ul>
            </span>
        </div>

        <div class="card-instruction mb-5">
            <p class="fw-semibold mb-1">
                <i class="bi bi-file-earmark-text me-1" style="color: goldenrod"></i> Tatacara Mengisi Laporan PKL
            </p>
            <ol class="mb-1">
                <li>Masuk ke menu Report.</li>
                <li>Klik tombol Add Report.</li>
                <li>
                    Isi data berikut:
                    <ul>
                        <li>Foto Saat Bimbingan</li>
                        <li>Deskripsi Kegiatan</li>
                        <li>File Laporan</li>
                    </ul>
                </li>
            </ol>
        </div>
    </div>
</div>

@code {
    private string fullName = "";
    private string secondLine = "";
    private string photoUrl = "/images/default_profile.jpg";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
        }

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrWhiteSpace(token)) return;

        var authHeader = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        // ===== Ambil data user =====
        var request = new HttpRequestMessage(HttpMethod.Get, APIUrl.Endpoint("me"));
        request.Headers.Authorization = authHeader;
        var response = await Http.SendAsync(request);

        if (!response.IsSuccessStatusCode) return;

        var json = await response.Content.ReadAsStringAsync();
        var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;

        fullName = root.GetProperty("fullname").GetString() ?? "";
        string role = "";
        if (root.TryGetProperty("role", out var roleProp))
            role = roleProp.GetString() ?? "";

        else if (root.TryGetProperty("roles", out var rolesProp) && rolesProp.ValueKind == JsonValueKind.String)
            role = rolesProp.GetString() ?? "";

        // Jika student, tampilkan nama kelas
        if (role.Trim().ToLower() == "student" && root.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Object)
        {
            if (dataProp.TryGetProperty("classroom", out var classroomProp))
                secondLine = classroomProp.GetString() ?? "";
            else secondLine = "Student";
        }
        else if (role.Trim().ToLower() == "student" && root.TryGetProperty("data", out var dataArrProp) && dataArrProp.ValueKind == JsonValueKind.Array)
        {
            if (dataArrProp.GetArrayLength() > 0)
            {
                var first = dataArrProp[0];
                if (first.TryGetProperty("classroom", out var classroomProp))
                    secondLine = classroomProp.GetString() ?? "";
                else secondLine = "Student";
            }
            else secondLine = "Student";
        }
        else secondLine = string.IsNullOrWhiteSpace(role) ? "-" : role;

        // ===== Ambil foto profile =====
        if (root.TryGetProperty("profile", out var profileProp) &&
            profileProp.ValueKind != JsonValueKind.Null)
        {
            var photoRequest = new HttpRequestMessage(HttpMethod.Get, APIUrl.Endpoint("me/photo"));
            photoRequest.Headers.Authorization = authHeader;
            var photoResponse = await Http.SendAsync(photoRequest);

            if (photoResponse.IsSuccessStatusCode)
            {
                var bytes = await photoResponse.Content.ReadAsByteArrayAsync();
                var contentType = photoResponse.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
                var base64 = Convert.ToBase64String(bytes);
                photoUrl = $"data:{contentType};base64,{base64}";
            }
        }
    }

    private void GoToProfile() => Navigation.NavigateTo("/home/profile");
}

