@attribute [Authorize]
@page "/home"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Model
@inject AuthenticationStateProvider AuthStateProvider

<div class="home-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="user-info">
            <p class="text-white">Selamat datang,</p>
            <p class="fw-bold text-white" style="font-size: 1.2rem;">@fullName</p>
            <p class="fw-semibold text-white" style="font-size: 0.8rem;">@secondLine</p>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        <div class="card-instruction mb-3">
            <p class="fw-semibold mb-1">
                <i class="bi bi-check-circle me-1" style="color: green"></i> Tatacara Presensi Kehadiran PKL
            </p>
            <ol class="mb-1">
                <li>Masuk ke menu Presence.</li>
                <li>
                    Pilih status kehadiran.
                    <ul>
                        <li>Hadir</li>
                        <li>Sakit</li>
                        <li>Izin</li>
                        <li>Libur</li>
                        <li>WFH</li>
                    </ul>
                </li>
            </ol>
            <span class="d-block mt-2">
                <p class="mb-0" style="color: red">
                    Note:
                </p>
                <ul>
                    <li>Presensi dilakukan setiap hari, dan hanya dapat dilakukan <span class='fw-bold'>1x</span> dalam sehari.</li>
                </ul>
            </span>
        </div>

        <div class="card-instruction mb-3">
            <p class="fw-semibold mb-1">
                <i class="bi bi-file-earmark-text me-1" style="color: goldenrod"></i> Tatacara Mengisi Laporan PKL
            </p>
            <ol class="mb-1">
                <li>Masuk ke menu Report.</li>
                <li>Klik tombol "Add Report".</li>
                <li>
                    Isi data berikut:
                    <ul>
                        <li>Foto Saat Bimbingan</li>
                        <li>Deskripsi Kegiatan</li>
                        <li>File Laporan</li>
                    </ul>
                </li>
            </ol>
        </div>

        @if (userRole == "Student")
        {
            <div class="card-instruction mb-3">
                <p class="fw-semibold mb-1">
					<i class="bi bi-journal-text me-1" style="color: blue"></i> Rekap Presensi dan Bimbingan Laporan
                </p>
                <ul class="mb-1" type="circle">
                    <li>Anda akan diminta untuk menyertakan rekap ini dalam berkas Laporan PKL Anda.</li>
					<li>Cara melihat dan mendapatkannya:
						<ol>
							<li>Masuk ke menu Profile.</li>
							<li>Klik menu "Recap".</li>
							<li>Download File Rekap milik Anda, lalu Print dan sertakan dalam berkas Laporan PKL</li>
                        </ol>
                    </li>
                </ul>
                <span class="d-block mt-2">
                    <p class="mb-0" style="color: red">
                        Note:
                    </p>
                    <ul>
                        <li>Rekap ini hanya bisa Anda dapatkan jika sudah <span class='fw-bold'>diterbitkan</span> oleh Kepala Jurusan.</li>
                    </ul>
                </span>
            </div>
		}
    </div>
</div>

@code {
    private string fullName = "";
    private string secondLine = "";
    private string userRole = "";
    private string photoUrl = "/images/default_profile.jpg";

    protected override async Task OnInitializedAsync()
    {
        var meJson = await JS.InvokeAsync<string>("localStorage.getItem", "meResponse");
        if (string.IsNullOrWhiteSpace(meJson))
            return;

        var root = JsonDocument.Parse(meJson).RootElement;
        fullName = root.TryGetProperty("fullname", out var fnProp) ? fnProp.GetString() ?? "" : "";
        userRole = root.TryGetProperty("role", out var roleProp) ? roleProp.GetString() ?? "" : "";

        // Data Student
        if (userRole.ToLower() == "student" &&
            root.TryGetProperty("data", out var dataProp))
        {
            if (dataProp.TryGetProperty("classroom", out var classroomProp))
                secondLine = classroomProp.GetString() ?? "";
        }
        else secondLine = userRole;
        
        // Foto (juga tanpa header Authorization)
        if (root.TryGetProperty("profile", out var profileProp) &&
            profileProp.ValueKind != JsonValueKind.Null)
        {
            var request = new HttpRequestMessage(HttpMethod.Get, APIUrl.Endpoint("me/photo"));
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var contentType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
                var base64 = Convert.ToBase64String(bytes);
                photoUrl = $"data:{contentType};base64,{base64}";
            }
        }
    }

    private void GoToProfile() => Navigation.NavigateTo("/home/profile");
}

