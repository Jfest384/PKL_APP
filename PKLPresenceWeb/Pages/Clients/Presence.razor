    void ToggleDatePicker()
    {
        showDatePicker = !showDatePicker;
    }

    async Task OnDateSelected(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(dateValue))
            return;

        // Validasi: hari Minggu tidak bisa dipilih
        if (DateTime.TryParse(dateValue, out var dt))
        {
            if (dt > DateTime.Today)
            {
                await JS.InvokeVoidAsync("alert", "Tanggal lebih dari hari ini tidak bisa dipilih.");
                return;
            }
            if (dt.DayOfWeek == DayOfWeek.Sunday)
            {
                await JS.InvokeVoidAsync("alert", "Hari Minggu tidak bisa dipilih.");
                return;
            }
        }

        showDatePicker = false;
        selectedDate = dateValue;
        CurrentPage = 1;
        await LoadPresence(selectedDate);
    }

