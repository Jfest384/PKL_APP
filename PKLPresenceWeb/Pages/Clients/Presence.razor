@page "/presence"
@using PKLPresenceWeb.Model
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

<div class="presence-wrapper">
    <div class="header-section d-flex align-items-center">
        <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
            <i class="bi-chevron-left fw-bold"></i>
        </button>
        <h5 class="mb-0 fw-bold text-white">Presence</h5>
    </div>

    <div class="content-section">
        @if (UserRole == "Student")
        {
            <div class="d-flex justify-content-center gap-2 mb-3 presence-radio-group">
                @foreach (var type in PresenceTypes)
                {
                    <div class="form-check form-check-inline" style="margin-bottom:0;">
                        <input class="form-check-input presence-radio-input"
                               type="radio"
                               name="presenceType"
                               id="presenceType_@type.id"
                               value="@type.id"
                               checked="@(SelectedPresenceTypeId == type.id)"
                               @onchange="() => OnPresenceTypeChanged(type.id)"
                               disabled="@HasPresenceToday" />
                        <label class="form-check-label presence-radio-label" for="presenceType_@type.id">
                            @type.name
                        </label>
                    </div>
                }
            </div>

            <div class="scrollable-x">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            <th class="text-center">Hari/Tanggal</th>
                            <th class="text-center">Jam</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Feedback</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Presences is not null && Presences.Count > 0)
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize;
                            @foreach (var item in Presences)
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    <td>@item.date</td>
                                    <td>@item.time</td>
                                    <td>@item.presence_type</td>
                                    <td>@item.feedback</td>
                                    <td>
                                        <button class="btn btn-sm btn-success" @onclick="() => ShowDetail(item)">Detail</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">Tidak ada data presensi.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <select class="form-select page-size-dropdown m-3" @bind="PageSize">
                <option value="5">Show 5 Entries</option>
                <option value="10">Show 10 Entries</option>
                <option value="15">Show 15 Entries</option>
            </select>

            <nav class="d-flex justify-content-center mt-2">
                <ul class="pagination">
                    @if (Presences is null || Presences.Count == 0)
                    {
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                        </li>
                        <li class="page-item disabled">
                            <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                <button class="page-link"
                                        @onclick="() => ChangePage(pageNum)"
                                        disabled="@(pageNum == CurrentPage)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        </li>
                    }
                </ul>
            </nav>

            @if (ShowPresenceModal)
            {
                <Modal IsVisible="true" Title="@SelectedPresenceTypeName">
                    <div class="modal-scrollable-content">
                        @foreach (var field in PresenceTypeFields.GetValueOrDefault(SelectedPresenceTypeId, new()))
                        {
                            <div class="mb-3">
                                <label class="d-block mt-2 mb-1 fw-normal">@field.Label</label>
                                @if (field.Field == "Location")
                                {
                                    <div id="presenceMap" style="height: 150px; border-radius: 8px; border: 1px solid #ccc;"></div>
                                    <div class="mt-2">
                                        <span class="text-muted">Latitude: @CurrentLat, Longitude: @CurrentLng</span>
                                    </div>
                                }
                                else
                                {
                                    @if (IsWebRTCField(field.Field))
                                    {
                                        <label class="upload-box border rounded"
                                               @onclick="() => OnPhotoBoxClick(field.Field)">
                                            @* ... (isi box, sama seperti sebelumnya) *@
                                            @if (PresencePhotoPreviews.ContainsKey(field.Field) && PresencePhotoPreviews[field.Field] != null)
                                            {
                                                <img src="@PresencePhotoPreviews[field.Field]" style="display:block; max-height:180px; max-width:240px; width:auto; height:auto; margin:auto;" />
                                            }
                                            else if (ActiveWebRTCField == field.Field)
                                            {
                                                <video id="webrtc_@field.Field" autoplay playsinline style="width:100%;height:120px;object-fit:cover;border-radius:8px;background:#222;"></video>
                                            }
                                            else
                                            {
                                                <span class="text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                    }
                                    else
                                    {
                                        <label class="upload-box border rounded"
                                               for="fileInput_@field.Field">
                                            @if (PresencePhotoPreviews.ContainsKey(field.Field) && PresencePhotoPreviews[field.Field] != null)
                                            {
                                                <img src="@PresencePhotoPreviews[field.Field]" style="display:block; max-height:180px; max-width:240px; width:auto; height:auto; margin:auto;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                        <InputFile id=@($"fileInput_{field.Field}")
                                                   class="d-none"
                                                   accept="image/*"
                                                   OnChange="@(e => OnPhotoChanged(e, field.Field))" />
                                    }
                                }

                            </div>
                        }
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="CancelPresenceModal" disabled="@IsSubmittingPresence">Cancel</button>
                            <button class="btn btn-success px-4"
                                    @onclick="ConfirmPresenceModal"
                                    disabled="@(!IsPresenceFormValid || IsSubmittingPresence || !IsLocationValid)">
                                Confirm
                            </button>
                        </div>
                    </div>
                </Modal>
            }

            @if (ShowWebRTCModal && WebRTCField != null)
            {
                <Modal IsVisible="true" Title="Ambil Foto">
                    <div class="d-flex flex-column align-items-center">
                        <video id="webrtc_@WebRTCField" autoplay playsinline class="webrtc-modal-video"></video>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-danger" @onclick="CloseWebRTCModal">Cancel</button>
                            <button class="btn btn-success" @onclick="CaptureWebRTCPhoto">Capture</button>
                        </div>
                    </div>
                </Modal>
            }
        }
        else
        {
            <div class="row g-2 mb-3">
                <div class="col">
                    <input class="form-control" placeholder="Nama Siswa..." @bind="searchName" @oninput="OnFilterChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in ClassList)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="scrollable-x">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th class="text-center">No</th>
                                <th class="text-center">NIS</th>
                                <th class="text-center">Nama Lengkap</th>
                                <th class="text-center">Kelas</th>
                                <th class="text-center">Today</th>
                                <th class="text-center" style="position:relative;">
                                    <button class="btn btn-link p-0 fw-bold" @onclick="ToggleDatePicker" style="color:inherit;">
                                        Hari/Tanggal
                                        <i class="bi bi-chevron-down ms-1"></i>
                                    </button>
                                    @if (showDatePicker)
                                    {
                                        <div style="position: absolute; z-index: 10;">
                                            <input type="date"
                                                   class="form-control"
                                                   value="@selectedDate"
                                                   min="@MinDate"
                                                   max="@MaxDate"
                                                   style="width:150px;"
                                                   @onchange="OnDateSelected" />
                                        </div>
                                    }
                                </th>
                                <th class="text-center">Jam</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Feedback</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Presences is not null && Presences.Count > 0)
                            {
                                var rowIndex = (CurrentPage - 1) * 10;
                                @foreach (var item in Presences)
                                {
                                    rowIndex++;
                                    <tr>
                                        <td class="text-center">@rowIndex</td>
                                        <td>@item.nis</td>
                                        <td>@item.name</td>
                                        <td>@item.classroom_name</td>
                                        <td class="text-center">
                                            @if (item.isPresence == "✔️")
                                            {
                                                <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                            else
                                            {
                                                <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                        </td>
                                        <td>@item.date</td>
                                        <td>@item.time</td>
                                        <td>@item.presence_type</td>
                                        <td>@item.feedback</td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => ShowDetail(item)"
                                                        disabled="@(string.IsNullOrWhiteSpace(item.presence_type) || item.presence_type == "-")">
                                                    Detail
                                                </button>
                                                @if (UserRole == "Kepala Jurusan" || UserRole == "Mentor" || UserRole == "Wali kelas")
                                                {
                                                    <button class="btn btn-sm btn-warning"
                                                            @onclick="() => ShowFeedback(item)"
                                                            disabled="@((item.presence_type == "-"))">
                                                        Feedback
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted">Tidak ada data presensi.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mb-2">
                    <div class="mw-100 mt-3">
                        <select id="rekapDropdown" class="form-select" @bind="selectedDropdown">
                            <option value="" disabled selected hidden>Cetak Rekap</option>
                            <option value="Siswa">Per Siswa</option>
                            <option value="Pembimbing">Per Pembimbing</option>
                            <option value="Kelas">Per Kelas</option>
                        </select>
                    </div>
                </div>

                <nav class="d-flex justify-content-center mt-2">
                    <ul class="pagination">
                        @if (Presences is null || Presences.Count == 0)
                        {
                            <li class="page-item disabled">
                                <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Prev</button>
                            </li>
                            <li class="page-item disabled">
                                <button type="button" class="page-link disabled" disabled style="pointer-events:none;opacity:0.6;">Next</button>
                            </li>
                        }
                        else
                        {
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(pageNum == CurrentPage ? "active" : null)">
                                    <button class="page-link"
                                            @onclick="() => ChangePage(pageNum)"
                                            disabled="@(pageNum == CurrentPage)">
                                        @pageNum
                                    </button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                                <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }

        @if ((ShowDetailModal || ShowFeedbackModal) && SelectedPresenceDetail != null)
        {
            <Modal IsVisible="true" Title="@ModalTitle">
                <div class="modal-scrollable-content">
                    <div class="presence-modal-grid mb-3 mt-3 text-start">
                        <div class="presence-modal-label">NIS</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.nis</div>

                        <div class="presence-modal-label">Nama Lengkap</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.name</div>

                        <div class="presence-modal-label">Kelas</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.classroom_name</div>

                        <div class="presence-modal-label">Hari/Tanggal</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.date</div>

                        <div class="presence-modal-label">Jam</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.time WIB</div>

                        <div class="presence-modal-label">Status</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.presence_type</div>

                        @if (ShowDetailModal)
                        {
                            <div class="presence-modal-label">Feedback</div>
                            <div class="presence-modal-colon">:</div>
                            <div class="presence-modal-value">@SelectedPresenceDetail.feedback</div>

                            <div class="presence-modal-label">Bukti Foto</div>
                            <div class="presence-modal-colon">:</div>
                            <div class="presence-modal-value">
                                <button type="button" class="presence-modal-link btn btn-link p-0" @onclick="PreviewFoto">Preview Foto</button>
                            </div>
                        }
                        else
                        {
                            <div class="presence-modal-label">Feedback</div>
                            <div class="presence-modal-colon">:</div>
                        }
                    </div>
                    @if (ShowDetailModal)
                    {
                        @if (SelectedPresenceDetail.presence_type == "Hadir")
                        {
                            <div class="presence-modal-value">
                                <div id="detailPresenceMap" class="detail-presence-map"></div>
                                <div class="mt-2 text-muted" style="font-size:small;">
                                    Latitude: @SelectedPresenceDetail.lat, Longitude: @SelectedPresenceDetail.longitude
                                </div>
                            </div>
                        }
                        <button class="btn btn-primary w-100 mb-2 mt-2" @onclick="CloseDetailModal">Close</button>
                    }
                    @if (ShowFeedbackModal)
                    {
                        <div class="mb-3">
                            <textarea id="feedbackInput"
                                      class="form-control"
                                      placeholder="Masukkan Feedback"
                                      @bind="FeedbackInput"
                                      @oninput="e => FeedbackInput = ((ChangeEventArgs)e).Value?.ToString() ?? string.Empty"
                                      rows="3"></textarea>
                        </div>
                        <button class="btn btn-primary w-100 mb-2"
                                @onclick="OnFeedbackButtonClick"
                                disabled="@IsSubmittingFeedback">
                            @(string.IsNullOrWhiteSpace(FeedbackInput) ? "Close" : "Confirm")
                        </button>
                    }
                </div>
            </Modal>
        }

        @if (ShowPresencePhotoModal)
        {
            <Modal IsVisible="true" Title="@PreviewPresenceTypeName">
                <div class="modal-scrollable-content">
                    @if (IsLoadingPresencePhotos)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var field in PreviewPresenceFields
                                        .Where(f => PreviewPresenceTypeId != 1 || f.Field == "FullBodyPhoto"))
                        {
                            <div class="mb-3">
                                <label class="d-block mt-2 mb-1 fw-normal">@field.Label</label>
                                <label class="upload-box border rounded">
                                    @if (PreviewPresencePhotoUrls.ContainsKey(field.Field) && PreviewPresencePhotoUrls[field.Field] != null)
                                    {
                                        <img src="@PreviewPresencePhotoUrls[field.Field]" style="display:block; max-height:180px; max-width:240px; width:auto; height:auto; margin:auto;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                            <i class="bi bi-image" style="font-size:2rem;"></i>
                                            <br />Tidak ada foto
                                        </span>
                                    }
                                </label>
                            </div>
                        }
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-danger px-4" @onclick="() => ShowPresencePhotoModal = false">Close</button>
                        </div>
                    }
                </div>
            </Modal>
        }
    </div>
</div>

@code {
    Dictionary<string, string?> PresencePhotoPreviews = new();

    private string UserRole = "";
    private List<PresenceItem> Presences = new();
    private List<ClassItem> ClassList = new();
    private string searchName = "";
    private int? selectedClassId;
    private string selectedDropdown = "";
    private bool isLoading = false;

    private int CurrentPage = 1;
    private int TotalPages = 1;

    private CancellationTokenSource? searchDebounceCts;

    // Date picker state
    private bool showDatePicker = false;
    private string selectedDate = "";
    private string MinDate => DateTime.Today.AddYears(-1).ToString("yyyy-MM-dd"); // Optional: set min date
    private string MaxDate => DateTime.Today.ToString("yyyy-MM-dd");

    // State modal presence
    bool ShowPresenceModal = false;
    int SelectedPresenceTypeId = 0;
    string SelectedPresenceTypeName = "";
    Dictionary<string, IBrowserFile?> PresencePhotos = new();
    bool IsSubmittingPresence = false;

    string ModalTitle = "";
    bool ShowDetailModal = false;
    bool ShowFeedbackModal = false;
    PresenceItem? SelectedPresenceDetail = null;

    string FeedbackInput = "";
    bool IsSubmittingFeedback = false;

    // Untuk modal preview foto presence
    bool ShowPresencePhotoModal = false;
    int PreviewPresenceTypeId = 0;
    string PreviewPresenceTypeName = "";
    Dictionary<string, string?> PreviewPresencePhotoUrls = new(); // key: field, value: photo url
    List<(string Label, string Field)> PreviewPresenceFields = new();
    bool IsLoadingPresencePhotos = false;

    string LocationInput = "";
    double CurrentLat = 0;
    double CurrentLng = 0;

    bool IsLocationValid =>
    SelectedPresenceTypeId != 1 ||
    (CurrentLat != 0 && CurrentLng != 0);

    private bool ShowWebRTCModal = false;
    private string? WebRTCField = null;

    private string? ActiveWebRTCField = null;
    private DotNetObjectReference<Presence>? dotNetRef;

    [JSInvokable]
    public async Task OnWebRTCCapture(string elementId, string dataUrl)
    {
        var field = elementId.Replace("webrtc_", "");
        PresencePhotoPreviews[field] = dataUrl;

        // Convert base64 to byte[] and set as IBrowserFile (for upload)
        var base64 = dataUrl.Substring(dataUrl.IndexOf(",") + 1);
        var bytes = Convert.FromBase64String(base64);
        var file = new BlazorInputFileStreamFile(field + ".jpg", "image/jpeg", bytes);
        PresencePhotos[field] = file;

        // Tutup modal WebRTC
        ShowWebRTCModal = false;
        WebRTCField = null;
        ActiveWebRTCField = null;
        StateHasChanged();
    }

    private void OnPhotoBoxClick(string field)
    {
        if (IsWebRTCField(field))
        {
            WebRTCField = field;
            ShowWebRTCModal = true;
        }
        else TriggerFileInput(field);
    }

    private bool IsWebRTCField(string field)
        => field == "FullBodyPhoto" || field == "Treatment" || field == "Activity";

    private async Task StartWebRTC()
    {
        if (WebRTCField != null)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("webrtcPhoto.start", $"webrtc_{WebRTCField}", dotNetRef);
        }
    }

    private async void CloseWebRTCModal()
    {
        if (WebRTCField != null)
        {
            await JS.InvokeVoidAsync("webrtcPhoto.stop", $"webrtc_{WebRTCField}");
        }
        ShowWebRTCModal = false;
        WebRTCField = null;
        StateHasChanged();
    }

    private async void CaptureWebRTCPhoto()
    {
        if (WebRTCField != null)
        {
            await JS.InvokeVoidAsync("webrtcPhoto.capture", $"webrtc_{WebRTCField}");
        }
    }

    // private async void SwitchWebRTCCamera()
    // {
    //     if (WebRTCField != null)
    //     {
    //         dotNetRef ??= DotNetObjectReference.Create(this);
    //         await JS.InvokeVoidAsync("webrtcPhoto.switchCamera", $"webrtc_{WebRTCField}", dotNetRef);
    //     }
    // }

    private Dictionary<string, InputFile> inputFileRefs = new();

    private InputFile GetInputFileRef(string field)
    {
        if (!inputFileRefs.ContainsKey(field))
            inputFileRefs[field] = null;
        return inputFileRefs[field];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowWebRTCModal && WebRTCField != null)
            await StartWebRTC();

        if (ShowDetailModal && SelectedPresenceDetail != null && SelectedPresenceDetail.presence_type == "Hadir")
        {
            if (double.TryParse(SelectedPresenceDetail.lat, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lat) &&
                double.TryParse(SelectedPresenceDetail.longitude, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lng))
            {
                await JS.InvokeVoidAsync("renderPresenceMapWithMarker", "detailPresenceMap", lat, lng, null);
            }
        }
    }

    private bool HasPresenceToday =>
    Presences.Any(p =>
        DateTime.TryParseExact(
            p.date,
            "dddd, dd MMMM yyyy",
            new CultureInfo("id-ID"),
            DateTimeStyles.None,
            out var dt
        ) && dt.Date == DateTime.Today
    );

    // Mapping presence type ke field foto
    readonly Dictionary<int, List<(string Label, string Field)>> PresenceTypeFields = new()
    {
        // Sesuaikan id dengan id presenceType Anda
        { 1, new() { ("Foto Full Body", "FullBodyPhoto"), ("Location", "Location") } }, // Hadir
        { 2, new() { ("Surat MC", "MedicalCertificate"), ("Saat Berobat", "Treatment"), ("Info Sakit ke Perusahaan", "SickToCompany"), ("Info Sakit ke Pembimbing Sekolah", "SickToMentor"), ("Info Sakit ke Walas", "SickToWalas") } }, // Sakit
        { 3, new() { ("Izin ke Perusahaan", "PermitToCompany"), ("Izin ke Pembimbing Sekolah", "PermitToMentor"), ("Izin ke Walas", "PermitToWalas"), ("Kegiatan yang dilakukan", "Activity") } }, // Izin
        { 4, new() { ("Info Libur dari Perusahaan", "HolidayFromCompany") } }, // Libur
        // Tambahkan mapping lain jika ada
    };

    private async Task ShowPresencePhotoModalForPresence(PresenceItem item)
    {
        ShowPresencePhotoModal = false;
        IsLoadingPresencePhotos = true;
        PreviewPresencePhotoUrls.Clear();

        // Dapatkan presence type id dari item.presence_type
        var type = PresenceTypes.FirstOrDefault(x =>
            x.name.Trim().Equals(item.presence_type.Trim(), StringComparison.OrdinalIgnoreCase));
        if (type == null)
        {
            await JS.InvokeVoidAsync("alert", $"PresenceType master: {string.Join(", ", PresenceTypes.Select(x => x.name))}\nDari item: {item.presence_type}");
            return;
        }
        PreviewPresenceTypeId = type.id;
        PreviewPresenceTypeName = type.name;
        PreviewPresenceFields = PresenceTypeFields.GetValueOrDefault(PreviewPresenceTypeId, new());

        // Ambil foto dari API
        try
        {
            var photos = await Http.GetFromJsonAsync<List<PresencePhotoResponse>>(APIUrl.Endpoint($"presence/{item.id_presence}/photos"));
            if (photos != null)
            {
                foreach (var field in PreviewPresenceFields)
                {
                    var photo = photos.FirstOrDefault(p => MapPhotoTypeToField(p.type) == field.Field);
                    var apiBase = "http://localhost:5027";
                    if (photo != null)
                    {
                        // Ganti http ke https jika frontend diakses via https
                        var base64 = await GetPhotoBase64Async($"{apiBase}{photo.url}");
                        PreviewPresencePhotoUrls[field.Field] = base64;
                    }
                    else
                    {
                        PreviewPresencePhotoUrls[field.Field] = null;
                    }
                }
            }
        }
        catch { await JS.InvokeVoidAsync("alert", "Gagal mengambil foto presensi."); }

        IsLoadingPresencePhotos = false;
        ShowPresencePhotoModal = true;
        StateHasChanged();
    }

    // Mapping type dari API ke field PresenceTypeFields
    private string MapPhotoTypeToField(string type)
    {
        return type switch
        {
            "photoBody" => "FullBodyPhoto",
            "medicalCertificate" => "MedicalCertificate",
            "activity" => "Activity",
            "treatment" => "Treatment",
            "sickToCompany" => "SickToCompany",
            "sickToMentor" => "SickToMentor",
            "sickToWalas" => "SickToWalas",
            "permitToCompany" => "PermitToCompany",
            "permitToMentor" => "PermitToMentor",
            "permitToWalas" => "PermitToWalas",
            "holidayFromCompany" => "HolidayFromCompany",
            _ => type
        };
    }

    private async Task<string?> GetPhotoBase64Async(string photoUrl)
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, photoUrl);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) return null;
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var ext = System.IO.Path.GetExtension(photoUrl).ToLower();
            var mime = ext == ".png" ? "image/png" : "image/jpeg";
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch { return null; }
    }

    // Student presence page
    private List<PresenceTypeItem> PresenceTypes = new();
    private int pageSize = 10;
    private int PageSize
    {
        get => pageSize;
        set
        {
            if (pageSize != value)
            {
                pageSize = value;
                CurrentPage = 1;
                _ = LoadStudentPresences();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var user = await Http.GetFromJsonAsync<UserResponse>(APIUrl.Endpoint("me"));
        UserRole = user.role;

        if (UserRole == "Student")
        {
            await LoadPresenceTypes();
            await LoadStudentPresences();
        }
        else
        {
            await LoadClasses();
            await LoadPresenceTypes();
            await LoadPresence();
        }
    }

    private async Task LoadPresenceTypes()
    {
        var types = await Http.GetFromJsonAsync<List<PresenceTypeItem>>(APIUrl.Endpoint("data/presence-types"));
        PresenceTypes = types ?? new();
    }

    private async Task LoadStudentPresences()
    {
        var url = APIUrl.Endpoint($"presence?page={CurrentPage}&pageSize={PageSize}");
        var response = await Http.GetFromJsonAsync<PresenceListResponse>(url);
        if (response != null)
        {
            Presences = response.data ?? new();
            TotalPages = response.totalPages;
        }
        StateHasChanged();
    }

    private async void OnPresenceTypeChanged(int typeId)
    {
        if (HasPresenceToday)
        {
            await JS.InvokeVoidAsync("alert", "Kamu sudah melakukan presensi hari ini.");
            return;
        }
        SelectedPresenceTypeId = typeId;
        SelectedPresenceTypeName = PresenceTypes.FirstOrDefault(x => x.id == typeId)?.name ?? "";
        PresencePhotos.Clear();
        ShowPresenceModal = true;

        if (typeId == 1)
        {
            var position = await JS.InvokeAsync<GeolocationPosition>("getCurrentPosition");
            CurrentLat = position.coords.latitude;
            CurrentLng = position.coords.longitude;
            await JS.InvokeVoidAsync("renderPresenceMapWithMarker", "presenceMap", CurrentLat, CurrentLng, DotNetObjectReference.Create(this));
        }
        StateHasChanged();
    }

