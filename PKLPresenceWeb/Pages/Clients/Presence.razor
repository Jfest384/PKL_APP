    async Task OnPhotoChanged(InputFileChangeEventArgs e, string field)
    {
        var file = e.File;
        if (file != null)
        {
            PresencePhotos[field] = file;
            using var stream = file.OpenReadStream(long.MaxValue);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            PresencePhotoPreviews[field] = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
        else
        {
            PresencePhotoPreviews[field] = null;
        }
        // Reset input file agar bisa pilih file yang sama dua kali
        if (inputFileRefs.TryGetValue(field, out var inputRef) && inputRef != null)
        {
            await JS.InvokeVoidAsync("resetInputFile", $"fileInput_{field}");
        }
        StateHasChanged();
    }

