@attribute [Authorize]
@page "/presence"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AlertService AlertService
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PKLPresenceWeb.Helper
@using PKLPresenceWeb.Model
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text.Json

<div class="presence-wrapper">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-white fw-bold p-0 me-2" @onclick="GoBack">
                <i class="bi-chevron-left fw-bold"></i>
            </button>
            <h5 class="mb-0 fw-bold text-white">Presence</h5>
        </div>
        <div class="photo-wrapper" @onclick="GoToProfile">
            <img src="@photoUrl" onerror="this.src='/images/default_profile.jpg'" class="profile-photo" />
        </div>
    </div>

    <div class="content-section">
        @if (UserRole == "Student")
        {
            <div class="d-flex justify-content-center mb-3 presence-radio-group flex-wrap">
                @if (PresenceTypes.Count > 0)
                {
                    <div class="presence-radio-row">
                        @for (int i = 0; i < Math.Min(3, PresenceTypes.Count); i++)
                        {
                            var type = PresenceTypes[i];
                            <div class="form-check form-check-inline" style="margin-bottom:0;">
                                <input class="form-check-input presence-radio-input"
                                       type="radio"
                                       name="presenceType"
                                       id="presenceType_@type.id"
                                       value="@type.id"
                                       checked="@(SelectedPresenceTypeId == type.id)"
                                       @onchange="() => OnPresenceTypeChanged(type.id)"
                                       disabled="@HasPresenceTodayGlobal" />
                                <label class="form-check-label presence-radio-label" for="presenceType_@type.id">
                                    @type.name
                                </label>
                            </div>
                        }
                    </div>
                    <div class="presence-radio-row">
                        @for (int i = 3; i < PresenceTypes.Count; i++)
                        {
                            var type = PresenceTypes[i];
                            <div class="form-check form-check-inline" style="margin-bottom:0;">
                                <input class="form-check-input presence-radio-input"
                                       type="radio"
                                       name="presenceType"
                                       id="presenceType_@type.id"
                                       value="@type.id"
                                       checked="@(SelectedPresenceTypeId == type.id)"
                                       @onchange="() => OnPresenceTypeChanged(type.id)"
                                       disabled="@HasPresenceTodayGlobal" />
                                <label class="form-check-label presence-radio-label" for="presenceType_@type.id">
                                    @type.name
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="scrollable-x">
                <table class="table table-bordered student-table">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            <th class="text-center">Hari/Tanggal</th>
                            <th class="text-center">Jam</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Report</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Presences is not null && Presences.Count > 0)
                        {
                            var rowIndex = (CurrentPage - 1) * PageSize;
                            @foreach (var item in Presences)
                            {
                                rowIndex++;
                                <tr>
                                    <td class="text-center">@rowIndex</td>
                                    <td>@item.date</td>
                                    <td>@item.time</td>
                                    <td>@item.presence_type</td>
                                    <td class="text-center">
                                        @if (item.isComplete == "✔️")
                                        {
                                            <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                        }
                                        else if (item.isComplete == "✔️ ⚠️")
                                        {
                                            <span class="bi bi-check text-success"
                                                  style="font-size: 2rem; font-weight: bold; vertical-align: middle;"></span>
                                            <span class="bi bi-exclamation-triangle-fill text-warning"
                                                  style="font-size: 1.2rem; font-weight: bold; vertical-align: middle; position: relative; top: 1.5px;"></span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex flex-column gap-2 align-items-center justify-content-center presence-action-group">
                                            <button class="btn btn-sm btn-success" @onclick="() => ShowDetail(item)"
                                                    style="padding-left: 0.65rem; padding-right: 0.65rem;">
                                                <i class="bi bi-info-circle me-1"></i> Detail
                                            </button>
                                            <button class="btn btn-sm btn-warning"
                                                    @onclick="() => ShowReportModal(item)"
                                                    disabled="@(item.presence_type == "-" || GetPresenceTypeId(item) == 4 || (item.isComplete != "❌" && !IsToday(item.date)))">
                                                <i class="bi bi-pencil me-1"></i> Report
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">Tidak ada data presensi.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <select class="form-select page-size-dropdown mt-3 mb-3" style="max-width:170px;" @bind="PageSize">
                <option value="10">Show 10 Entries</option>
                <option value="50">Show 50 Entries</option>
                <option value="100">Show 100 Entries</option>
                <option value="1000">Show All Entries</option>
            </select>

            <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                <ul class="pagination d-flex flex-wrap justify-content-center">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                        <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                        <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>

                    <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                        <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                    </li>

                    @if (CurrentPage <= 3)
                    {
                        for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    else if (CurrentPage >= TotalPages - 2)
                    {
                        if (TotalPages > 5)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        for (int i = TotalPages - 3; i < TotalPages; i++)
                        {
                            if (i > 1)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }
                        }
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>

                        for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    @if (TotalPages > 1)
                    {
                        <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                        </li>
                    }

                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                        <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                        <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>

            @if (ShowPresenceModal)
            {
                <Modal IsVisible="true" Title="@SelectedPresenceTypeName">
                    <div class="mb-2" style="max-height:400px;overflow-y:auto;">
                        @foreach (var field in PresenceTypeFields.GetValueOrDefault(SelectedPresenceTypeId, new()))
                        {
                            <div class="mb-3">
                                <label class="d-block mt-2 mb-1 fw-normal">@field.Label</label>
                                @if (field.Field == "Location")
                                {
                                    <div id="presenceMap" style="height: 150px; border-radius: 8px; border: 1px solid #ccc;"></div>
                                    <div class="mt-2">
                                        <span class="text-muted">Latitude: @CurrentLat, Longitude: @CurrentLng</span>
                                    </div>
                                }
                                else
                                {
                                    @if (IsWebRTCField(field.Field))
                                    {
                                        <label class="upload-box-report"
                                               @onclick="() => OnPhotoBoxClick(field.Field)">
                                            @if (PresencePhotoPreviews.ContainsKey(field.Field) && PresencePhotoPreviews[field.Field] != null)
                                            {
                                                <img src="@PresencePhotoPreviews[field.Field]" />
                                            }
                                            else if (ActiveWebRTCField == field.Field)
                                            {
                                                <video id="webrtc_@field.Field" autoplay playsinline style="width:100%;height:120px;object-fit:cover;border-radius:4px;background:#222;"></video>
                                            }
                                            else
                                            {
                                                <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                    }
                                    else
                                    {
                                        <label class="upload-box-report"
                                               for="fileInput_@field.Field">
                                            @if (PresencePhotoPreviews.ContainsKey(field.Field) && PresencePhotoPreviews[field.Field] != null)
                                            {
                                                <img src="@PresencePhotoPreviews[field.Field]" class="img-upload-preview" />
                                            }
                                            else
                                            {
                                                <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                        <InputFile id=@($"fileInput_{field.Field}")
                                                   class="d-none"
                                                   accept="image/*"
                                                   OnChange="@(e => OnPhotoChanged(e, field.Field))" />
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <button class="btn btn-danger px-4" @onclick="CancelPresenceModal" disabled="@IsSubmittingPresence">Cancel</button>
                        <button class="btn btn-success px-4"
                                @onclick="ConfirmPresenceModal"
                                disabled="@(!IsPresenceFormValid || IsSubmittingPresence || !IsLocationValid)">
                            Confirm
                        </button>
                    </div>
                </Modal>
            }

            @if (ShowReportModalFlag)
            {
                <Modal IsVisible="true" Title="@ReportPresenceTypeName">
                    <div class="mb-2" style="max-height:400px;overflow-y:auto;">
                        @if (ReportPresenceTypeId == 1 || ReportPresenceTypeId == 5)
                        {
                            <div class="mb-1 mx-1">
                                <label class="mb-2">Ringkasan Pekerjaan</label>
                                <textarea class="form-control"
                                          placeholder="Masukkan report..." 
                                          @bind="ReportTextInput" 
                                          @oninput="OnContentInput"
                                          maxlength="200" 
                                          rows="4">
                                </textarea>
                                <div class="char-counter-outer">@ReportTextInput.Length/200</div>
                            </div>
                        }
                        else if (ReportPresenceTypeId == 2)
                        {
                            <div class="d-flex flex-column align-items-center gap-4 mb-2">
                                <div class="text-center w-100">
                                    <div class="mb-1 fw-normal">Surat MC</div>
                                    <label class="upload-box-report" @onclick='() => OnPhotoBoxClick("MedicalCertificate", isReport: true)'>
                                        @if (ReportPhotoPreviews.ContainsKey("MedicalCertificate") && ReportPhotoPreviews["MedicalCertificate"] != null)
                                        {
                                            <img src="@ReportPhotoPreviews["MedicalCertificate"]" />
                                        }
                                        else
                                        {
                                            <div class="upload-box-inner m-2">
                                                <i class="bi bi-image" style="font-size:2.5rem;color:#888"></i>
                                                <div class="mt-2 text-secondary">Upload Foto</div>
                                            </div>
                                        }
                                    </label>
                                </div>
                                <div class="text-center w-100">
                                    <div class="mb-1 fw-normal">Info Sakit Ke Perusahaan</div>
                                    <label class="upload-box-report">
                                        <InputFile class="d-none" OnChange='e => OnReportPhotoChanged(e, "SickToCompany")' accept="image/*" />
                                        @if (ReportPhotoPreviews.ContainsKey("SickToCompany") && ReportPhotoPreviews["SickToCompany"] != null)
                                        {
                                            <img src="@ReportPhotoPreviews["SickToCompany"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <div class="upload-box-inner m-2">
                                                <i class="bi bi-image" style="font-size:2.5rem;color:#888;"></i>
                                                <div class="mt-2 text-secondary">Upload Foto</div>
                                            </div>
                                        }
                                    </label>
                                </div>
                                <div class="text-center w-100">
                                    <div class="mb-1 fw-normal">Info Sakit ke Pembimbing Sekolah</div>
                                    <label class="upload-box-report">
                                        <InputFile class="d-none" OnChange='e => OnReportPhotoChanged(e, "SickToMentor")' accept="image/*" />
                                        @if (ReportPhotoPreviews.ContainsKey("SickToMentor") && ReportPhotoPreviews["SickToMentor"] != null)
                                        {
                                            <img src="@ReportPhotoPreviews["SickToMentor"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <div class="upload-box-inner m-2">
                                                <i class="bi bi-image" style="font-size:2.5rem;color:#888;"></i>
                                                <div class="mt-2 text-secondary">Upload Foto</div>
                                            </div>
                                        }
                                    </label>
                                </div>
                                <div class="text-center w-100">
                                    <div class="mb-1 fw-normal">Info Sakit ke Walas</div>
                                    <label class="upload-box-report">
                                        <InputFile class="d-none" OnChange='e => OnReportPhotoChanged(e, "SickToWalas")' accept="image/*" />
                                        @if (ReportPhotoPreviews.ContainsKey("SickToWalas") && ReportPhotoPreviews["SickToWalas"] != null)
                                        {
                                            <img src="@ReportPhotoPreviews["SickToWalas"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <div class="upload-box-inner m-2">
                                                <i class="bi bi-image" style="font-size:2.5rem;color:#888;"></i>
                                                <div class="mt-2 text-secondary">Upload Foto</div>
                                            </div>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                        else if (ReportPresenceTypeId == 3)
                        {
                            <div class="d-flex flex-column align-items-center gap-4 mb-2">
                                <div class="text-center w-100">
                                    <div class="mb-1 fw-normal">Kegiatan yang dilakukan</div>
                                    <label class="upload-box-report" @onclick='() => OnPhotoBoxClick("Activity", isReport: true)'>
                                        @if (ReportPhotoPreviews.ContainsKey("Activity") && ReportPhotoPreviews["Activity"] != null)
                                        {
                                            <img src="@ReportPhotoPreviews["Activity"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <div class="upload-box-inner m-2">
                                                <i class="bi bi-image m-2" style="font-size:2.5rem;color:#888;"></i>
                                                <div class="mt-2 text-secondary">Upload Foto</div>
                                            </div>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <button class="btn btn-danger px-4" style="min-width:90px;" @onclick="CancelReportModal">Cancel</button>
                        <button class="btn btn-success px-4" style="min-width:90px;"
                                @onclick="ConfirmReportModal"
                                disabled="@( !IsReportFormValid )">
                            Confirm
                        </button>
                    </div>
                </Modal>
            }

            @if (ShowWebRTCModal && WebRTCField != null)
            {
                <Modal IsVisible="true">
                    <div class="modal-header position-relative">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2"
                                aria-label="Close" @onclick="CloseWebRTCModal">
                        </button>

                        <h5 class="modal-title fw-bold w-100 text-center">Ambil Foto</h5>
                    </div>

                    <div class="position-relative d-flex flex-column align-items-center mt-3">
                        <video id="webrtc_@WebRTCField" autoplay playsinline class="webrtc-modal-video"></video>
                        @if (IsWebRTCCaptureCounting && WebRTCCaptureCountdown > 0)
                        {
                            <div class="webrtc-countdown-anim">
                                @WebRTCCaptureCountdown
                            </div>
                        }

                        <!-- Tombol kontrol -->
                        <div class="d-flex gap-3 mt-3 align-items-center">

                            <!-- Timer dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-warning" type="button" id="timerMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clock"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownTimerBtn">
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(0))">None</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(3))">3s</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(5))">5s</a></li>
                                    <li><a class="dropdown-item" @onclick="@(() => SetTimer(7))">7s</a></li>
                                </ul>
                            </div>

                            <!-- Capture -->
                            <button class="btn-circle-capture" @onclick="CaptureWebRTCPhoto">
                                <i class="bi bi-camera" style="font-size:1.2rem; color: black"></i>
                            </button>

                            @* <!-- Switch Camera -->
                            <button class="btn btn-primary" @onclick="SwitchCamera">
                                <i class="bi bi-arrow-repeat" style="color: black"></i>
                            </button> *@
                        </div>
                    </div>
                </Modal>
            }
        }
        else
        {
            <div class="row g-2 mb-3 align-items-end">
                <div class="col">
                    <input class="form-control" placeholder="Search..." @bind="searchName" @oninput="OnFilterChanged" />
                </div>
                <div class="col">
                    <select class="form-select" @onchange="OnClassChange">
                        <option value="">All Classes</option>
                        @foreach (var cls in ClassList)
                        {
                            <option value="@cls.id">@cls.name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="date-group-responsive d-flex align-items-center gap-1">
                        <button class="chevron-date-btn"
                                @onclick="PrevDate">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <input type="date"
                               class="form-control"
                               style="min-width: 120px;"
                               value="@selectedDate"
                               min="@MinDate"
                               max="@MaxDate"
                               @onchange="OnDateSelected" />
                        <button class="chevron-date-btn"
                                @onclick="NextDate"
                                disabled="@IsTodaySelected">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center mb-3 presence-toolbar">
                @if (UserRole == "Admin" || UserRole == "Kepala Jurusan")
                {
                    <div class="d-flex gap-2 btn-group-toolbar">
                        <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="PrintPerMentor">
                            <span class="d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-printer"></i>
                                <span class="d-none d-sm-inline">Per Mentor</span>
                                <span class="d-inline d-sm-none">Mentor</span>
                            </span>
                        </button>

                        <button class="btn btn-primary flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="PrintPerClass">
                            <span class="d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-printer"></i>
                                <span class="d-none d-sm-inline">Per Class</span>
                                <span class="d-inline d-sm-none">Class</span>
                            </span>
                        </button>
                    </div>
                    <div class="d-flex align-items-center ms-auto locklocation-toolbar">
                        <span class="me-2 locklocation-text">Lock Location</span>
                        <label class="switch mt-1">
                            <input type="checkbox" checked="@IsLockLocationOn" @onchange="OnLockLocationSwitchChanged" />
                            <span class="slider round" style="background:@SliderColor"></span>
                        </label>
                    </div>
                }
                else
                {
                    <button class="btn btn-warning flex-grow-1 flex-md-grow-0" style="min-width:120px;" @onclick="Print">
                        <span class="d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-printer"></i> Print
                        </span>
                    </button>
                }
            </div>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="scrollable-x">
                    <table class="table table-bordered mentor-table">
                        <thead>
                            <tr>
                                <th class="text-center">No</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(PresenceItem.nis))">
                                    NIS
                                    @if (SortColumn == nameof(PresenceItem.nis))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(PresenceItem.name))">
                                    Nama Lengkap
                                    @if (SortColumn == nameof(PresenceItem.name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(PresenceItem.classroom_name))">
                                    Kelas
                                    @if (SortColumn == nameof(PresenceItem.classroom_name))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick='() => SortBy("Today")'>
                                    Today
                                    @if (SortColumn == "Today")
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center">Hari/Tanggal</th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(PresenceItem.time))">
                                    Jam
                                    @if (SortColumn == nameof(PresenceItem.time))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick="() => SortBy(nameof(PresenceItem.presence_type))">
                                    Status
                                    @if (SortColumn == nameof(PresenceItem.presence_type))
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center sortable" @onclick='() => SortBy("Report")'>
                                    Report
                                    @if (SortColumn == "Report")
                                    {
                                        <span class="sort-arrow">
                                            @(SortAscending ? "▲" : "▼")
                                        </span>
                                    }
                                </th>
                                <th class="text-center">Tanggal Report</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Presences is not null && Presences.Count > 0)
                            {
                                var sortedPresences = PageSize == 1000
                                ? GetSortedPresences()
                                : GetSortedPresences().Skip((CurrentPage - 1) * PageSize).Take(PageSize);
                                var rowIndex = PageSize == 1000 ? 0 : (CurrentPage - 1) * PageSize;
                                foreach (var item in sortedPresences)
                                {
                                    rowIndex++;
                                    <tr>
                                        <td class="text-center">@rowIndex</td>
                                        <td>@item.nis</td>
                                        <td>@item.name</td>
                                        <td>@item.classroom_name</td>
                                        <td class="text-center">
                                            @if (item.isPresence == "✔️")
                                            {
                                                <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                            else
                                            {
                                                <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                        </td>
                                        <td>@item.date</td>
                                        <td>@item.time</td>
                                        <td>@item.presence_type</td>
                                        <td class="text-center">
                                            @if (item.isComplete == "✔️")
                                            {
                                                <span class="bi bi-check text-success" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                            else if (item.isComplete == "✔️ ⚠️")
                                            {
                                                <span class="bi bi-check text-success"
                                                      style="font-size: 2rem; font-weight: bold; vertical-align: middle;"></span>
                                                <span class="bi bi-exclamation-triangle-fill text-warning"
                                                      style="font-size: 1.2rem; font-weight: bold; vertical-align: middle; position: relative; top: 1.5px;"></span>
                                            }
                                            else
                                            {
                                                <span class="bi bi-x text-danger" style="font-size: 2rem; font-weight: bold"></span>
                                            }
                                        </td>
                                        <td>@item.updateAt</td>
                                        <td>
                                            @if (UserRole != "Teacher")
                                            {
                                                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center presence-action-group" style="min-width:120px;">
                                                    <div class="action-grid">
                                                        <button class="btn btn-sm btn-success"
                                                                @onclick="() => ShowDetail(item)"
                                                                disabled="@(string.IsNullOrWhiteSpace(item.presence_type) || item.presence_type == "-")">
                                                            <i class="bi bi-info-circle"></i>
                                                            <span class="btn-text-sm-hide ms-1">Detail</span>
                                                        </button>
                                                        <button class="btn btn-sm btn-warning"
                                                                @onclick="() => ShowFeedback(item)"
                                                                disabled="@((item.presence_type == "-"))">
                                                            <i class="bi bi-chat-dots"></i>
                                                            <span class="btn-text-sm-hide ms-1">Feedback</span>
                                                        </button>
                                                        <button class="btn btn-sm btn-primary"
                                                                @onclick="() => PrintStudentPresence(item)"
                                                                disabled="@(string.IsNullOrWhiteSpace(item.presence_type) || item.presence_type == "-")">
                                                            <i class="bi bi-printer"></i>
                                                            <span class="btn-text-sm-hide ms-1">Print</span>
                                                        </button>
                                                        <button class="btn btn-sm btn-danger"
                                                                @onclick="() => ShowDeletePresenceConfirmation(item)"
                                                                disabled="@(string.IsNullOrWhiteSpace(item.presence_type) || item.presence_type == "-")">
                                                            <i class="bi bi-trash"></i>
                                                            <span class="btn-text-sm-hide ms-1">Delete</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-muted">Tidak ada data presensi.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <select class="form-select page-size-dropdown my-3" style="max-width:170px;" @bind="PageSize">
                    <option value="10">Show 10 Entries</option>
                    <option value="50">Show 50 Entries</option>
                    <option value="100">Show 100 Entries</option>
                    <option value="1000">Show All Entries</option>
                </select>

                <nav class="d-flex justify-content-center mt-2" style="padding: 1rem;">
                    <ul class="pagination d-flex flex-wrap justify-content-center">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>

                        <li class="page-item @(CurrentPage == 1 ? "active" : null)">
                            <button class="page-link" @onclick="() => ChangePage(1)" disabled="@(CurrentPage == 1)">1</button>
                        </li>

                        @if (CurrentPage <= 3)
                        {
                            for (int i = 2; i <= Math.Min(4, TotalPages - 1); i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        else if (CurrentPage >= TotalPages - 2)
                        {
                            if (TotalPages > 5)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            for (int i = TotalPages - 3; i < TotalPages; i++)
                            {
                                if (i > 1)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                    </li>
                                }
                            }
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>

                            for (int i = CurrentPage - 1; i <= CurrentPage + 1; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : null)">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)" disabled="@(pageNumber == CurrentPage)">@pageNumber</button>
                                </li>
                            }

                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @if (TotalPages > 1)
                        {
                            <li class="page-item @(CurrentPage == TotalPages ? "active" : null)">
                                <button class="page-link" @onclick="() => ChangePage(TotalPages)" disabled="@(CurrentPage == TotalPages)">@TotalPages</button>
                            </li>
                        }

                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : null)">
                            <button class="page-link btn-text" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
                            <button class="page-link btn-icon" @onclick="() => ChangePage(CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            }
        }

        @if ((ShowDetailModal || ShowFeedbackModal) && SelectedPresenceDetail != null)
        {
            <Modal IsVisible="true">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    @if (UserRole != "Student")
                    {
                        <button class="chevron-date-btn"
                                @onclick="ShowPrevPresence"
                                disabled="@(SelectedPresenceIndex <= 0)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    }
                    <span class="fw-bold" style="flex:1;text-align:center; font-size:20px">@ModalTitle</span>
                    @if (UserRole != "Student")
                    {
                        <button class="chevron-date-btn"
                                @onclick="ShowNextPresence"
                                disabled="@(SelectedPresenceIndex >= Presences?.Where(p => !string.IsNullOrWhiteSpace(p.presence_type) && p.presence_type != "-").Count() - 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
                <div class="mb-2" style="max-height:400px;overflow-y:auto;">
                    <div class="presence-modal-grid mb-3 mt-3 text-start">
                        <div class="presence-modal-label">NIS</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.nis</div>

                        <div class="presence-modal-label">Nama Lengkap</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.name</div>

                        <div class="presence-modal-label">Kelas</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.classroom_name</div>

                        <div class="presence-modal-label">Hari/Tanggal</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.date</div>

                        <div class="presence-modal-label">Jam</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.time WIB</div>

                        <div class="presence-modal-label">Status</div>
                        <div class="presence-modal-colon">:</div>
                        <div class="presence-modal-value">@SelectedPresenceDetail.presence_type</div>
                    </div>

                    <h6 class="fw-bold mt-3 mb-2" style="font-size:17px">Feedback</h6>

                    @if (ShowFeedbackModal)
                    {
                        <div class="mx-1">
                            <textarea id="feedbackInput"
                                      class="form-control"
                                      placeholder="Masukkan Feedback"
                                      @bind="FeedbackInput"
                                      @oninput="e => FeedbackInput = ((ChangeEventArgs)e).Value?.ToString()?.Substring(0, Math.Min(200, ((ChangeEventArgs)e).Value?.ToString()?.Length ?? 0)) ?? string.Empty"
                                      maxlength="200"
                                      rows="3"></textarea>
                            <div class="char-counter-outer">@FeedbackInput.Length/200</div>
                        </div>
                    }
                    else
                    {
                        <div class="feedback-grid text-start mb-3">
                            <div class="feedback-label">Kepala Jurusan</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedPresenceDetail.feedback?.kajur))</div>

                            <div class="feedback-label">Mentor</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedPresenceDetail.feedback?.mentor))</div>

                            <div class="feedback-label">Wali Kelas</div>
                            <div class="feedback-colon">:</div>
                            <div class="feedback-value">@((SelectedPresenceDetail.feedback?.walas))</div>
                        </div>
                    }

                    @if (PreviewPresenceFields != null && PreviewPresenceFields.Count > 0)
                    {
                        @if (PreviewPresenceTypeId == 5)
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold" style="font-size:17px">Photo & Report</h6>
                                <!-- Foto Full Body -->
                                <div class="mx-1">
                                    <label class="d-block mt-2 mb-1 fw-normal">Foto Full Body</label>
                                    <label class="upload-box-report">
                                        @if (PreviewPresencePhotoUrls.ContainsKey("FullBodyPhoto") && PreviewPresencePhotoUrls["FullBodyPhoto"] != null)
                                        {
                                            <img src="@PreviewPresencePhotoUrls["FullBodyPhoto"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Info WFH dari Perusahaan -->
                                <div class="mx-1">
                                    <label class="d-block mt-3 mb-1 fw-normal">Info WFH dari Perusahaan</label>
                                    <label class="upload-box-report">
                                        @if (PreviewPresencePhotoUrls.ContainsKey("WFHFromCompany") && PreviewPresencePhotoUrls["WFHFromCompany"] != null)
                                        {
                                            <img src="@PreviewPresencePhotoUrls["WFHFromCompany"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Laporan Harian -->
                                <div class="mx-1">
                                    <div class="mt-3 mb-1">Laporan Harian</div>
                                    <textarea class="form-control" rows="4" readonly style="background:#f8f9fa;">@PreviewPresenceReport</textarea>
                                </div>
                                <!-- Location -->
                                <div class="mx-1">
                                    <div class="mt-3 mb-1">Location</div>
                                    <div class="presence-modal-value">
                                        <div id="detailPresenceMap" class="detail-presence-map"></div>
                                        <div class="mt-2 text-muted" style="font-size:small;">
                                            * Klik Peta untuk preview pada Google Maps
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold" style="font-size:17px">Photo & Report</h6>
                                @foreach (var field in PreviewPresenceFields)
                                {
                                    <div class="mx-1">
                                        <label class="d-block mt-2 mb-1 fw-normal">@field.Label</label>
                                        <label class="upload-box-report">
                                            @if (PreviewPresencePhotoUrls.ContainsKey(field.Field) && PreviewPresencePhotoUrls[field.Field] != null)
                                            {
                                                <img src="@PreviewPresencePhotoUrls[field.Field]" class="img-upload-preview" />
                                            }
                                            else
                                            {
                                                <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                    <i class="bi bi-image" style="font-size:2rem;"></i>
                                                    <br />Upload Foto
                                                </span>
                                            }
                                        </label>
                                        @if ((field.Field == "FullBodyPhoto") && !string.IsNullOrWhiteSpace(PreviewPresenceReport))
                                        {
                                            <div class="mt-3 mb-1">Laporan Harian</div>
                                            <textarea class="form-control" rows="4" readonly style="background:#f8f9fa;">@PreviewPresenceReport</textarea>
                                            <div class="mt-3 mb-1">Location</div>
                                            <div class="presence-modal-value">
                                                <div id="detailPresenceMap" class="detail-presence-map"></div>
                                                <div class="mt-2 text-muted" style="font-size:small;">
                                                    * Klik Peta untuk preview pada Google Maps
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (ShowDetailModal) 
                {
                    <button class="btn btn-primary w-100 " @onclick="CloseDetailModal">Close</button>
                }
                @if (ShowFeedbackModal)
                {
                    <button class="btn btn-primary w-100"
                            @onclick="OnFeedbackButtonClick"
                            disabled="@IsSubmittingFeedback">
                        @(string.IsNullOrWhiteSpace(FeedbackInput) ? "Close" : "Confirm")
                    </button>
                }
            </Modal>
        }

        @if (ShowDeletePresenceModal)
        {
            <Modal IsVisible="true">
                <div class="text-center">
                    <i class="bi bi-trash fs-1 text-danger checkmark-animate"></i>
                    <p class="fw-bold">Delete Presence</p>
                    <p>
                        Apakah Anda yakin ingin menghapus data presensi milik siswa <b>@DeletePresenceName</b> di tanggal <b>@DeletePresenceDate</b>?
                    </p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-danger px-4" @onclick="CancelDeletePresence">No</button>
                        <button class="btn btn-success px-4" @onclick="ConfirmDeletePresenceAsync">Yes</button>
                    </div>
                </div>
            </Modal>
        }

        @if (ShowPrintMentorModal)
        {
            <Modal IsVisible="true" Title="Per Mentor">
                <div class="text-center mb-3">
                    <i class="bi bi-printer fs-1 text-warning checkmark-animate" style="font-size:2.5rem;"></i>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Mentor</label>
                    <select class="form-select" @onchange="OnMentorSelected">
                        <option value="">Pilih Mentor</option>
                        @foreach (var mentor in MentorList)
                        {
                            <option value="@mentor.id" selected="@(mentor.id == SelectedMentorId)">
                                @mentor.fullname
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Awal</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintStartDate"
                           min="@MinDate"
                           max="@MaxDate"
                           @onchange="OnPrintMentorStartDateChanged" />
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Akhir</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintEndDate"
                           min="@PrintStartDate"
                           max="@MaxDate"
                           @onchange="OnPrintMentorEndDateChanged"
                           disabled="@string.IsNullOrWhiteSpace(PrintStartDate)" />
                </div>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button class="btn btn-danger px-4" @onclick="CancelPrintMentorModal">Cancel</button>
                    <button class="btn btn-warning px-4"
                            @onclick="PrintMentor"
                            disabled="@(!CanPrint)">
                        Print
                    </button>
                </div>
            </Modal>
        }

        @if (ShowPrintClassModal)
        {
            <Modal IsVisible="true" Title="Per Kelas">
                <div class="text-center mb-3">
                    <i class="bi bi-printer fs-1 text-primary checkmark-animate" style="font-size:2.5rem;"></i>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Kelas</label>
                    <select class="form-select" @onchange="OnClassPrintSelected">
                        <option value="">Pilih Kelas</option>
                        @foreach (var cls in ClassList)
                        {
                            <option value="@cls.id" selected="@(cls.id == SelectedClassPrintId)">
                                @cls.name
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Awal</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintStartDate"
                           min="@MinDate"
                           max="@MaxDate"
                           @onchange="OnPrintClassStartDateChanged" />
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Akhir</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintEndDate"
                           min="@PrintStartDate"
                           max="@MaxDate"
                           @onchange="OnPrintClassEndDateChanged"
                           disabled="@string.IsNullOrWhiteSpace(PrintStartDate)" />
                </div>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button class="btn btn-danger px-4" @onclick="CancelPrintClassModal">Cancel</button>
                    <button class="btn btn-primary px-4"
                            @onclick="PrintClass"
                            disabled="@(!CanPrint)">
                        Print
                    </button>
                </div>
            </Modal>
        }

        @if (ShowPrintCombinedModal)
        {
            <Modal IsVisible="true" Title="Print Rekap Gabungan">
                <div class="text-center mb-3">
                    <i class="bi bi-printer fs-1 text-warning checkmark-animate" style="font-size:2.5rem;"></i>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Awal</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintStartDate"
                           min="@MinDate"
                           max="@MaxDate"
                           @onchange="OnPrintCombinedStartDateChanged" />
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Tanggal Akhir</label>
                    <input type="date"
                           class="form-control"
                           value="@PrintEndDate"
                           min="@PrintStartDate"
                           max="@MaxDate"
                           @onchange="OnPrintCombinedEndDateChanged"
                           disabled="@string.IsNullOrWhiteSpace(PrintStartDate)" />
                </div>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button class="btn btn-danger px-4" @onclick="CancelPrintCombinedModal">No</button>
                    <button class="btn btn-warning px-4"
                            @onclick="ConfirmPrintCombinedAsync"
                            disabled="@(!CanPrint)">
                        Yes
                    </button>
                </div>
            </Modal>
        }
    </div>
</div>