                                        {
                                            <img src="@PreviewPresencePhotoUrls["FullBodyPhoto"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Info WFH dari Perusahaan -->
                                <div class="mx-1">
                                    <label class="d-block mt-3 mb-1 fw-normal">Info WFH dari Perusahaan</label>
                                    <label class="upload-box-report">
                                        @if (PreviewPresencePhotoUrls.ContainsKey("WFHFromCompany") && PreviewPresencePhotoUrls["WFHFromCompany"] != null)
                                        {
                                            <img src="@PreviewPresencePhotoUrls["WFHFromCompany"]" class="img-upload-preview" />
                                        }
                                        else
                                        {
                                            <span class="upload-box text-muted d-flex flex-column align-items-center justify-content-center" style="height:120px;">
                                                <i class="bi bi-image" style="font-size:2rem;"></i>
                                                <br />Upload Foto
                                            </span>
                                        }
                                    </label>
                                </div>
                                <!-- Laporan Harian -->
                                <div class="mx-1">
                                    <div class="mt-3 mb-1">Laporan Harian</div>
