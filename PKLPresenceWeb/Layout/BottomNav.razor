@using PKLPresenceWeb.Model
@using System.Net.Http.Headers
@implements IDisposable
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@using PKLPresenceWeb.Pages
@using System.Text.Json
@inject NavigationManager NavigationManager

<nav class="bottom-nav-custom">
    <a href="/home" class="@GetClass("home")">
        <div class="nav-item-inner @(IsActive("home") ? "active" : "")">
            <i class="bi bi-house"></i>
            <span class="menu-label">Home</span>
        </div>
    </a>
    <a class="@GetClass("participant")" @onclick="@(e => HandleMenuClick("participant"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("participant") ? "active" : "")">
            <i class="bi @(ParticipantMenuIcon)"></i>
            <span class="menu-label">@ParticipantMenuLabel</span>
        </div>
    </a>
    <a class="@GetClass("presence")" @onclick="@(e => HandleMenuClick("presence"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("presence") ? "active" : "")">
            <i class="bi bi-calendar-check"></i>
            <span class="menu-label">Presence</span>
        </div>
    </a>
    <a class="@GetClass("report")" @onclick="@(e => HandleMenuClick("report"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("report") ? "active" : "")">
            <i class="bi bi-file-earmark-text"></i>
            <span class="menu-label">Report</span>
        </div>
    </a>
</nav>

@if (showWarningModal)
{
    <Modal IsVisible="true">
        <div class="text-center">
            <i class="bi bi-exclamation-triangle fs-1 mb-4 text-warning"></i>
            <p>Pastikan sudah melengkapi data diri Anda</p>
            <button class="btn btn-danger px-4" @onclick="CloseModal">Close</button>
        </div>
    </Modal>
}