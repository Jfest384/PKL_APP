@using PKLPresenceWeb.Model
@using System.Net.Http.Headers
@implements IDisposable
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@using PKLPresenceWeb.Pages
@inject NavigationManager NavigationManager

<nav class="bottom-nav-custom">
    <a href="/home" class="@GetClass("home")">
        <div class="nav-item-inner @(IsActive("home") ? "active" : "")">
            <i class="bi bi-house"></i>
            <span class="menu-label">Home</span>
        </div>
    </a>
    <a class="@GetClass("participant")" @onclick="@(e => HandleMenuClick("participant"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("participant") ? "active" : "")">
            <i class="bi @(ParticipantMenuIcon)"></i>
            <span class="menu-label">@ParticipantMenuLabel</span>
        </div>
    </a>
    <a class="@GetClass("presence")" @onclick="@(e => HandleMenuClick("presence"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("presence") ? "active" : "")">
            <i class="bi bi-calendar-check"></i>
            <span class="menu-label">Presence</span>
        </div>
    </a>
    <a class="@GetClass("report")" @onclick="@(e => HandleMenuClick("report"))" style="cursor:pointer;">
        <div class="nav-item-inner @(IsActive("report") ? "active" : "")">
            <i class="bi bi-file-earmark-text"></i>
            <span class="menu-label">Report</span>
        </div>
    </a>
</nav>

@if (showWarningModal)
{
    <Modal IsVisible="true">
        <div class="text-center">
            <i class="bi bi-exclamation-triangle fs-1 mb-4 text-warning"></i>
            <p>Pastikan sudah melengkapi data diri Anda</p>
            <button class="btn btn-danger px-4" @onclick="CloseModal">Close</button>
        </div>
    </Modal>
}

@code {
    private string currentPath = "";
    private bool isStudent = false;
    private bool isDataComplete = true;
    private bool showWarningModal = false;
    private bool isInitialized = false;

    private string ParticipantMenuLabel =>
    isAdminOrKepalaJurusan ? "Management" : "Participant";

    private string ParticipantMenuIcon =>
        isAdminOrKepalaJurusan ? "bi-gear" : "bi-person";

    private bool isAdminOrKepalaJurusan =>
        userRole == "Admin" || userRole == "Kepala Jurusan";

    private string userRole = "";

    protected override async Task OnInitializedAsync()
    {
        UpdatePath();
        Navigation.LocationChanged += OnLocationChanged;

        // Fetch user role and validate student data
        await CheckUserRoleAndValidateData();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePath();
        StateHasChanged();
    }

    private void UpdatePath()
    {
        currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
    }

    private string GetClass(string path) =>
        IsActive(path) ? "nav-item-custom active" : "nav-item-custom";

    private bool IsActive(string path) =>
        string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase);

    private async Task CheckUserRoleAndValidateData()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var userResponse = await Http.GetFromJsonAsync<UserResponse>(APIUrl.Endpoint("me"));
            userRole = userResponse?.role ?? "";
            isStudent = userRole == "Student";

            if (isStudent)
            {
                var userId = userResponse?.id;
                var response = await Http.GetFromJsonAsync<StudentPKLListResponse>(
                    APIUrl.Endpoint($"students/pkl?userIdFilter={userId}")
                );
                var studentResponse = response?.students?.FirstOrDefault();

                // Cek kelengkapan data
                isDataComplete = studentResponse != null
                    && !string.IsNullOrWhiteSpace(studentResponse.email)
                    && !string.IsNullOrWhiteSpace(studentResponse.company_name);
            }
            else
            {
                isDataComplete = true;
            }
        }
        catch
        {
            isDataComplete = false;
        }

        isInitialized = true;
    }

    private void HandleMenuClick(string menu)
    {
        if (!isInitialized)
        {
            return;
        }

        if (isStudent && !isDataComplete)
        {
            showWarningModal = true;
        }
        else
        {
            Navigation.NavigateTo($"/{menu}");
        }
    }



    private void CloseModal()
    {
        showWarningModal = false;
        NavigationManager.NavigateTo("/home/profile/me");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}