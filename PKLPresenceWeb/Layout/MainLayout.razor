@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="main-content">
    @Body
</div>

@if (ShowBottomNav)
{
    <BottomNav />
}

@code {
    private readonly string[] ExcludedRoutes = new[] { "login", "lapran-pkl/approval" };
    private bool isDark = false;

    private string CurrentPath =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].ToLower();

    private bool ShowBottomNav =>
        !string.IsNullOrWhiteSpace(CurrentPath) &&
        !ExcludedRoutes.Any(route => CurrentPath.StartsWith(route));

    protected override async Task OnInitializedAsync()
    {
        var saved = await JS.InvokeAsync<string>("themeManager.getTheme");
        isDark = saved == "dark";
        await JS.InvokeVoidAsync("themeManager.applyTheme", isDark);
    }
}